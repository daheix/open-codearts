+    const r1 = await it1.next();
+    expect(r1.value!.text).toBe("a");
+    ctrl.abort();
+    const r2 = await it1.next();
+    expect(r2.done).toBe(true); // abort → 立即放弃，不交付 "b"
+    await it1.return?.();
