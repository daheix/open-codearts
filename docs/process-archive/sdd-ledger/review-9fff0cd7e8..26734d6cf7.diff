+    // （模拟"部署后二进制被外部替换/损坏"，哈希可能仍巧合一致而运行态已坏——复验必须拦住）
+    const execByPath = {
+      run: async (cmd: string[]) => {
+        const target = cmd[0] ?? "";
+        if (target.includes("staging-")) return { code: 0, stdout: `${NEW_VERSION}\n`, stderr: "" };
