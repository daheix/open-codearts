+  clock: { now(): number };
+  /** sweep 循环宿主。 */
+  loop: TickLoop;
+  /** 独立验收执行器（透传 RunnerDeps.verifyRun；目标声明 verify 时必配）。 */
+  verifyRun?(cmd: string[]): Promise<{ ok: boolean; out: string }>;
