+/** 手动循环句柄（测试驱动 sweep；wake 只计数不驱动——驱动权在用例手里）。 */
+interface ManualLoop {
+  loop: TickLoop;
+  sweepOnce(): Promise<void>;
+  wakeCount(): number;
+}
+
+function makeManualLoop(): ManualLoop {
+  let sweepFn: (() => Promise<void>) | undefined;
+  let wakes = 0;
+  return {
+    loop: {
+      start(sweep: () => Promise<void>) {
+        sweepFn = sweep;
+      },
+      wake() {
+        wakes += 1;
+      },
+      stop() {
+        sweepFn = undefined;
+      },
+    },
+    sweepOnce: async () => {
+      await sweepFn?.();
+    },
+    wakeCount: () => wakes,
+  };
+}
