+describe("autoNudge 接线（R-dg5-①：宿主 cfg 默认 + 逐目标覆盖）", () => {
+  it("cfg.autoNudge=false：停滞不注入、strikes 不累计；逐目标 autoNudge=true 覆盖后恢复注入", async () => {
