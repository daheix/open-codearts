+/** exec 记录器：捕获 spawnPty 的 (args, env) 并返回指定 child。 */
+function recordingExec(child: PtyChild) {
+  const calls: Array<{ args: string[]; env: NodeJS.ProcessEnv }> = [];
+  return {
+    calls,
+    exec: {
+      spawnPty(args: string[], env: NodeJS.ProcessEnv): PtyChild {
+        calls.push({ args, env });
+        return child;
+      },
+    },
+  };
+}
