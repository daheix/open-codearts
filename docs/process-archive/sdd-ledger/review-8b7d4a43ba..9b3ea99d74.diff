+import { spawn } from "node:child_process";
+import { accessSync, constants, readdirSync, statSync, watch, type FSWatcher } from "node:fs";
+import { open } from "node:fs/promises";
+import { homedir } from "node:os";
+import * as path from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import type { BridgeConfig } from "../config";
+import { BridgeError } from "../errors";
+import type {
+  CodeartsTransport,
+  ObserveOptions,
+  SessionRef,
+  Signal,
+  TransportKind,
+} from "./types";
+
+/** 两段式注入的提交间隔毫秒（R-p1；v0.2.6 教训值）。 */
+const INJECT_COMMIT_DELAY_MS = 120;
+
+/** 观察空闲轮询周期毫秒：进程死亡检测（接口无 onExit，仅 alive() 可查）与日志 tail 兜底。 */
+const POLL_MS = 200;
+
+/** 内核数据根缺省值（R-p2；与 health.ts R-h3 同源）。 */
+const DEFAULT_KERNEL_DATA_DIR = path.join(homedir(), ".codeartsdoer", "cli-data");
+
+/** 内核日志文件名口径（与 health.ts KERNEL_LOG_RE 同源：log 目录顶层 kernel-*.log）。 */
+const KERNEL_LOG_RE = /^kernel-.+\.log$/;
+
+/** 可注入时钟（R-p1）：返回在 ms 毫秒后落定的 Promise。 */
+export type PtyClock = (ms: number) => Promise<void>;
+
+const defaultClock: PtyClock = (ms) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+/**
+ * sh 单引号转义：script -c 经 /bin/sh 语义执行（已实测 `&&` 生效），命令串中
+ * 的路径须转义以防空格/引号破坏。数据源仅为配置路径（installDir），非用户文本。
+ */
+export function shQuote(s: string): string {
+  return `'${s.replaceAll("'", `'\\''`)}'`;
+}
+
+/** PTY 子进程句柄（R-p5 注入 seam；实现方保证 onData 单播、write 同步入队）。 */
+export interface PtyChild {
+  pid: number;
+  onData(cb: (chunk: string) => void): void;
+  write(data: string): void;
+  kill(): void;
+  alive(): boolean;
+}
+
+/* ───── 生产缺省 PtyChild 实现（node child_process + script(1)） ───── */
+
+/** PATH 探测：返回可执行文件绝对路径；找不到返回 null（不做任何兜底替换）。 */
+function lookPath(exe: string, env: NodeJS.ProcessEnv): string | null {
+  if (exe.includes("/")) {
+    try {
+      accessSync(exe, constants.X_OK);
+      return exe;
+    } catch {
+      return null;
+    }
+  }
+  for (const dir of (env.PATH ?? "").split(":")) {
+    if (dir === "") continue;
+    const candidate = path.join(dir, exe);
+    try {
+      accessSync(candidate, constants.X_OK);
+      return candidate;
+    } catch {
+      // 该目录不存在此文件：继续搜下一目录（搜索语义，非兜底）
+    }
+  }
+  return null;
+}
+
+/**
+ * 生产缺省 spawnPty：spawn args[0]（detached，子进程为进程组长），stdio 三管道。
+ * - 可执行文件缺失：同步抛 PTY_HOST_UNAVAILABLE（无竞态，先探测后 spawn）；
+ * - R-p6：stdout/stderr 各持独立 StringDecoder，多字节跨 chunk 完整还原；
+ * - R-p4：kill = process.kill(-pid, SIGKILL) 整组终止；ESRCH = 已死（幂等）。
+ */
+export function nodeScriptSpawnPty(args: string[], env: NodeJS.ProcessEnv): PtyChild {
+  const exe = args[0];
+  if (exe === undefined || exe === "") {
+    throw new BridgeError("PTY_HOST_UNAVAILABLE", "spawnPty 参数缺少可执行文件名", {
+      remediation: "检查 ptyHost=script 的传输装配参数。",
+    });
+  }
+  const resolved = lookPath(exe, env);
+  if (resolved === null) {
+    throw new BridgeError("PTY_HOST_UNAVAILABLE", `PATH 上未找到可执行文件：${exe}`, {
+      remediation: "安装 util-linux（提供 script(1)），或将 ptyHost 配置为 tmux。",
+    });
+  }
+  const child = spawn(resolved, args.slice(1), {
+    detached: true, // R-p4：新会话/进程组，供 kill(-pid) 整树终止
+    env,
+    stdio: ["pipe", "pipe", "pipe"],
+  });
+  if (child.pid === undefined) {
+    throw new BridgeError("PTY_SPAWN_FAILED", `进程 spawn 失败：${exe}`);
+  }
+  const pid: number = child.pid; // 收窄捕获（闭包内 child.pid 类型为 number|undefined）
+
+  let exited = false;
+  const decOut = new StringDecoder("utf8"); // R-p6：每流独立解码器
+  const decErr = new StringDecoder("utf8");
+  let sink: ((chunk: string) => void) | null = null;
+
+  child.stdout?.on("data", (b: Buffer) => {
+    const s = decOut.write(b);
+    if (s !== "" && sink !== null) sink(s);
+  });
+  child.stderr?.on("data", (b: Buffer) => {
+    const s = decErr.write(b);
+    if (s !== "" && sink !== null) sink(s);
+  });
+  child.on("exit", () => {
+    exited = true;
+  });
+  // 流错误（典型：写端 EPIPE）= 底层进程已死：alive() 如实转 false（显式状态，
+  // 非兜底——不改变错误向调用方的呈现，inject 等入口仍会显式报 SESSION_NOT_ALIVE）。
+  const markDead = (): void => {
+    exited = true;
+  };
+  child.stdin?.on("error", markDead);
+  child.stdout?.on("error", markDead);
+  child.stderr?.on("error", markDead);
+  child.on("error", markDead);
+
+  return {
+    pid,
+    onData(cb) {
+      sink = cb;
+    },
+    write(data) {
+      child.stdin?.write(data);
+    },
+    kill() {
+      if (exited) return;
+      try {
+        process.kill(-pid, "SIGKILL"); // R-p4：负 pid = 整个进程组
+      } catch (e) {
+        const code = (e as NodeJS.ErrnoException | null)?.code;
+        if (code !== "ESRCH") {
+          throw new BridgeError(
+            "PTY_STOP_FAILED",
+            `进程组终止失败：pid=${pid} errno=${code ?? String(e)}`,
+            { cause: e },
+          );
+        }
+        // ESRCH：进程组已不存在——终止目标已达成（stop 幂等），非静默兜底
+      }
+    },
+    alive() {
+      return !exited;
+    },
+  };
+}
+
+/* ───── 会话状态与日志 tailer ───── */
+
+/** 单个 script PTY 会话的全部可变状态（经 ref.id 寻址）。 */
+interface PtySession {
+  ref: SessionRef;
+  child: PtyChild;
+  /** PTY 输出缓冲：全部 chunk 解码按序累积（snapshot.raw，与消费无关）。 */
+  raw: string;
+  /** 待消费信号队列（PTY chunk / 日志 service 行 / done）。 */
+  queue: Signal[];
+  /** observe 挂起等待者（wakeAll 唤醒后自旋复查状态）。 */
+  waiters: Array<() => void>;
+  /** 当前活跃观察者标记（单观察者模型；null = 无）。 */
+  observer: symbol | null;
+  /** stop 置位：观察迭代终止条件之一。 */
+  closed: boolean;
+  /** 进程死亡 done 信号是否已产出（只产一次）。 */
+  exitHandled: boolean;
+  /** 日志源状态（snapshot.meta.log；观察期间由 tailer 维护，serviceLines 跨观察累计）。 */
+  log: { available: boolean; file: string | null; serviceLines: number };
+}
+
+/** 日志 tailer（observe 生命期；R-p2）。 */
+interface LogTailer {
+  /** 增量扫描一次（事件驱动 + 观察轮询 tick 兜底调用；幂等、可重入合并）。 */
+  poll(): Promise<void>;
+  /** 关闭 watcher（幂等；关闭后 available 转 false 如实标注）。 */
+  close(): void;
+}
+
+/** 会话唤醒/等待机制（模块级：PTY 观察循环与日志 tailer 共用）。 */
+function wakeAll(s: PtySession): void {
+  const waiters = s.waiters.splice(0);
+  for (const wake of waiters) wake();
+}
+
+function waitFor(s: PtySession): Promise<void> {
+  return new Promise((resolve) => {
+    s.waiters.push(resolve);
+  });
+}
+
+/** 列出 log 目录顶层 kernel-*.log，按 mtime 降序取最新（并列按文件名）。 */
+function newestKernelLog(
+  dir: string,
+): { path: string; name: string; size: number; mtimeMs: number } | null {
+  let best: { path: string; name: string; size: number; mtimeMs: number } | null = null;
+  for (const name of readdirSync(dir)) {
+    if (!KERNEL_LOG_RE.test(name)) continue;
+    const full = path.join(dir, name);
+    const st = statSync(full);
+    if (!st.isFile()) continue;
+    if (
+      best === null ||
+      st.mtimeMs > best.mtimeMs ||
+      (st.mtimeMs === best.mtimeMs && name > best.name)
+    ) {
+      best = { path: full, name, size: st.size, mtimeMs: st.mtimeMs };
+    }
+  }
+  return best;
+}
+
+/**
+ * 装配日志 tailer（observe 调用时同步执行——statSync 基线保证确定性：observe
+ * 返回后追加的内容必被读到；watcher 就绪前的事件由观察轮询 tick 兜底）。
+ * - 基线 = 最新 kernel-*.log 当前大小（只看增量）；无文件/目录缺失 → 不可用态；
+ * - 事件（文件追加/目录建删）→ poll：重列目录，最新文件变化即切换（新文件从 0
+ *   读，轮转内容全新）；否则从 offset 增量读，完整行经 service= 过滤入队；
+ * - 一切 FS 错误按 R-p2 处理：不抛出，如实转不可用态（PTY 通道不受影响）。
+ */
+function armLogTailer(s: PtySession, kernelDataDir: string | undefined): LogTailer {
+  const dir = path.join(kernelDataDir ?? DEFAULT_KERNEL_DATA_DIR, "log");
+  let current: string | null = null;
+  let offset = 0;
+  let partial = ""; // 未遇 \n 的行尾残段（跨增量保持）
+  const decoder = new StringDecoder("utf8"); // 文件字节 → 字符（跨增量多字节安全）
+  let closedT = false;
+  let polling = false;
+  let dirty = false;
+  let fileWatcher: FSWatcher | null = null;
+  let dirWatcher: FSWatcher | null = null;
+
+  const markUnavailable = (): void => {
+    s.log = { ...s.log, available: false, file: null };
+  };
+
+  // ── 同步基线（确定性关键：observe 返回时基线已定） ──
+  try {
+    const newest = newestKernelLog(dir);
+    if (newest !== null) {
+      current = newest.path;
+      offset = newest.size;
+      s.log = { ...s.log, available: true, file: newest.name };
+    }
+  } catch {
+    markUnavailable(); // 目录缺失等（R-p2：不报错）
+  }
+
+  const rearmFileWatcher = (p: string): void => {
+    fileWatcher?.close();
+    fileWatcher = null;
+    try {
+      const w = watch(p, { persistent: false }, () => void tailer.poll());
+      w.on("error", () => {
+        // 被跟踪文件被删/失效（轮转常态）：关闭自身，目录 watcher + 轮询兜底恢复
+        w.close();
+        if (fileWatcher === w) fileWatcher = null;
+      });
+      fileWatcher = w;
+    } catch {
+      // watch 启动失败（文件竞态删除）：轮询兜底
+    }
+  };
+
+  const tailer: LogTailer = {
+    poll() {
+      if (closedT) return Promise.resolve();
+      if (polling) {
+        dirty = true;
+        return Promise.resolve();
+      }
+      polling = true;
+      const step = async (): Promise<void> => {
+        try {
+          do {
+            dirty = false;
+            await readIncrement();
+          } while (dirty);
+        } catch {
+          markUnavailable(); // R-p2：日志源任何错误不影响 PTY 通道
+        }
+      };
+      return step().finally(() => {
+        polling = false;
+      });
+    },
+    close() {
+      if (closedT) return;
+      closedT = true;
+      fileWatcher?.close();
+      fileWatcher = null;
+      dirWatcher?.close();
+      dirWatcher = null;
+      markUnavailable();
+    },
+  };
+
+  async function readIncrement(): Promise<void> {
+    let newest: ReturnType<typeof newestKernelLog> = null;
+    try {
+      newest = newestKernelLog(dir);
+    } catch {
+      markUnavailable(); // 目录在观察中被删（R-p2）
+      return;
+    }
+    if (newest === null) {
+      current = null;
+      offset = 0;
+      partial = "";
+      markUnavailable();
+      return;
+    }
+    if (newest.path !== current) {
+      // 轮转/首见新文件：从 0 读（新文件内容全部为增量），残段作废
+      rearmFileWatcher(newest.path);
+      current = newest.path;
+      offset = 0;
+      partial = "";
+      s.log = { ...s.log, available: true, file: newest.name };
+    }
+    if (offset >= newest.size) return; // 无增量
+    const fh = await open(newest.path, "r");
+    try {
+      const len = newest.size - offset;
+      const buf = Buffer.alloc(len);
+      const { bytesRead } = await fh.read(buf, 0, len, offset);
+      offset += bytesRead;
+      partial += decoder.write(buf.subarray(0, bytesRead));
+    } finally {
+      await fh.close();
+    }
+    const lines = partial.split("\n");
+    partial = lines.pop() ?? ""; // 末段可能不完整：留待下一增量
+    for (const raw of lines) {
+      const line = raw.endsWith("\r") ? raw.slice(0, -1) : raw;
+      if (!line.includes("service=")) continue; // R-p2：仅 service= 行转为信号
+      s.log.serviceLines++;
+      s.queue.push({ t: "output", at: Date.now(), text: line });
+    }
+    wakeAll(s);
+  }
+
+  // 目录 watcher：轮转（新建/删除/重命名）感知；追加事件在部分平台亦可见，
+  // 与文件 watcher 双保险，均只作 poll 触发信号。
+  try {
+    dirWatcher = watch(dir, { persistent: false }, () => void tailer.poll());
+    dirWatcher.on("error", () => {
+      dirWatcher?.close();
+      dirWatcher = null;
+    });
+  } catch {
+    markUnavailable(); // 目录缺失等（R-p2：不报错）
+  }
+  if (current !== null) rearmFileWatcher(current);
+
+  return tailer;
+}
+
+/* ───── script(1) 传输 ───── */
+
+/** createScriptTransport 选项。 */
+export interface ScriptTransportOptions {
+  /** 注入时钟（R-p1 缺省 setTimeoutPromise）；观察轮询 tick 同用此时钟。 */
+  clock?: PtyClock;
+}
+
+/**
+ * 构造 script(1) PTY 宿主传输。
+ * @param exec PtyChild 注入 seam（R-p5）：生产传 { spawnPty: nodeScriptSpawnPty }；
+ *   测试可注入 fake child 或经 nodeScriptSpawnPty 真实 spawn bash fixture。
+ */
+export function createScriptTransport(
+  exec: { spawnPty(args: string[], env: NodeJS.ProcessEnv): PtyChild },
+  opts: ScriptTransportOptions = {},
+): CodeartsTransport {
+  const clock = opts.clock ?? defaultClock;
+  const kind: TransportKind = "pty";
+  /** 会话表：id → 状态（含已 stop 会话：snapshot/留痕不丢）。 */
+  const sessions = new Map<string, PtySession>();
+  let idNext = 0;
+
+  function requireSession(ref: SessionRef): PtySession {
+    const s = sessions.get(ref.id);
+    if (s === undefined) {
+      throw new BridgeError("SESSION_UNKNOWN", `未知会话引用：kind=${ref.kind} id=${ref.id}`, {
+        remediation: "仅可使用本 transport.start 返回过的 SessionRef。",
+      });
+    }
+    return s;
+  }
+
+  function assertInjectable(s: PtySession, ref: SessionRef): void {
+    if (s.closed || !s.child.alive()) {
+      throw new BridgeError(
+        "SESSION_NOT_ALIVE",
+        `会话已结束，拒绝操作：id=${ref.id}`,
+        {
+          remediation: "script 宿主会话不可复活；请新建会话（start 不带 ref）。",
+        },
+      );
+    }
+  }
+
+  const transport: CodeartsTransport = {
+    kind,
+
+    async start(cfg: BridgeConfig, ref?: SessionRef): Promise<SessionRef> {
+      if (ref !== undefined) {
+        const s = requireSession(ref);
+        assertInjectable(s, ref);
+        return { ...s.ref }; // 复用语义：存活会话幂等返回（真实 PTY 无恢复概念）
+      }
+      const id = `script-${++idNext}`;
+      const created: SessionRef = { kind, id };
+      const cmd = shQuote(path.join(cfg.installDir, "bin", "codearts"));
+      // R-p5：argv 数组传递，无 shell 字符串拼接；-c 命令串经 shQuote 转义
+      const child = exec.spawnPty(["script", "-qefc", cmd, "/dev/null"], process.env);
+      const s: PtySession = {
+        ref: created,
+        child,
+        raw: "",
+        queue: [],
+        waiters: [],
+        observer: null,
+        closed: false,
+        exitHandled: false,
+        log: { available: false, file: null, serviceLines: 0 },
+      };
+      // onData 单播：start 时接线一次，输出持续入 raw + 队列（与是否观察无关）
+      child.onData((chunk) => {
+        s.raw += chunk;
+        s.queue.push({ t: "output", at: Date.now(), text: chunk });
+        wakeAll(s);
+      });
+      sessions.set(id, s);
+      return { ...created };
+    },
+
+    async inject(ref: SessionRef, text: string): Promise<void> {
+      const s = requireSession(ref);
+      assertInjectable(s, ref);
+      if (text.includes("\r") || text.includes("\n")) {
+        throw new BridgeError(
+          "INJECT_TEXT_MULTILINE",
+          `注入文本含换行符（长度=${text.length}），与两段式提交契约冲突`,
+          { remediation: "单行文本注入；多行内容分行多次 inject，每段单独提交。" },
+        );
+      }
+      s.child.write(text);
+      await clock(INJECT_COMMIT_DELAY_MS); // R-p1：两段式提交窗口
+      assertInjectable(s, ref); // 窗口期死亡：显式报错，不向死进程写 "\r"
+      s.child.write("\r");
+    },
+
+    observe(ref: SessionRef, observeOpts?: ObserveOptions): AsyncIterable<Signal> {
+      const s = requireSession(ref);
+      if (s.observer !== null) {
+        throw new BridgeError("OBSERVER_ACTIVE", `会话已有活跃观察者（单观察者模型）：id=${ref.id}`, {
+          remediation: "先结束当前观察（迭代完成/return/abort）再重新 observe。",
+        });
+      }
+      if (observeOpts?.signal?.aborted) return emptySignals(); // 未开始即取消
+
+      const token = Symbol("observer");
+      s.observer = token;
+      // tailer 同步装配（statSync 基线在返回前确定——增量语义的确定性关键）
+      const tailer = armLogTailer(s, observeOpts?.kernelDataDir);
+      const signal = observeOpts?.signal;
+      let terminated = false;
+      const release = (): void => {
+        if (s.observer === token) s.observer = null;
+        tailer.close();
+      };
+
+      async function* iterate(): AsyncGenerator<Signal> {
+        const onAbort = (): void => wakeAll(s);
+        signal?.addEventListener("abort", onAbort, { once: true });
+        try {
+          while (true) {
+            // abort = 立即放弃：残存不交付、保留给下一次 observe（T9 基准同态）
+            if (signal?.aborted || terminated) return;
+            if (s.queue.length > 0) {
+              yield s.queue.shift() as Signal;
+              continue;
+            }
+            if (s.closed) return; // stop：观察直接终止（不产 done，与 Fake 同态）
+            if (!s.child.alive()) {
+              if (!s.exitHandled) {
+                s.exitHandled = true;
+                s.queue.push({ t: "done", at: Date.now() }); // 进程自然退出：一次性 done
+                continue;
+              }
+              return;
+            }
+            const tick = clock(POLL_MS).then(() => {
+              void tailer.poll(); // 日志 tail 兜底（事件丢失/未就绪窗口）
+            });
+            await Promise.race([waitFor(s), tick]);
+          }
+        } finally {
+          signal?.removeEventListener("abort", onAbort);
+          release();
+        }
+      }
+
+      // 包装迭代器（与 FakeTransport M34 同构）：显式 return/throw 先同步终结
+      // 挂起等待并释放观察者/关闭 tailer，再委托内部 generator——"未启动即
+      // return"（generator 体未执行、finally 不触发）也不泄漏 watcher。
+      const inner = iterate();
+      const iterator: AsyncIterator<Signal> = {
+        next: () => inner.next(),
+        return: (v?: unknown) => {
+          terminated = true;
+          release();
+          wakeAll(s);
+          return inner.return(v as undefined);
+        },
+        throw: (e?: unknown) => {
+          terminated = true;
+          release();
+          wakeAll(s);
+          return inner.throw(e);
+        },
+      };
+      return { [Symbol.asyncIterator]: () => iterator };
+    },
+
+    async alive(ref: SessionRef): Promise<boolean> {
+      const s = requireSession(ref);
+      return !s.closed && s.child.alive();
+    },
+
+    async stop(ref: SessionRef): Promise<void> {
+      const s = requireSession(ref);
+      if (!s.closed) {
+        s.closed = true;
+        if (s.child.alive()) s.child.kill(); // R-p4：整组 SIGKILL（实现见 nodeScriptSpawnPty）
+      }
+      wakeAll(s);
+    },
+
+    async snapshot(ref: SessionRef): Promise<{ raw: string; meta: Record<string, unknown> }> {
+      const s = requireSession(ref);
+      return {
+        raw: s.raw,
+        meta: {
+          id: s.ref.id,
+          kind: s.ref.kind,
+          host: "script",
+          pid: s.child.pid,
+          alive: !s.closed && s.child.alive(),
+          closed: s.closed,
+          log: { ...s.log },
+        },
+      };
+    },
+  };
+
+  return transport;
+}
+
+/** 空信号迭代（observe 收到已 abort 的 signal 时返回；不占观察者、不装配 tailer）。 */
+function emptySignals(): AsyncIterable<Signal> {
+  return (async function* () {})();
+}
