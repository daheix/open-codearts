+        // 简单空白切分为 argv（验收命令不支持引号参数——登记为已知边界，
+        // 复杂命令由 T3-05 宿主侧执行器扩展）。
+        const argv = cmd.split(/\s+/).filter((p) => p !== "");
+        const r = await run(argv);
+        this.deps.audit({
+          type: "goal.verify",
+          goalId: this.st.goalId,
+          at: this.now(),
