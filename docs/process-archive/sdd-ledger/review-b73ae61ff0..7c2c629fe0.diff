+  private async tickLocked(): Promise<GoalState> {
+    const now = this.now();
+    await this.quiescePump(); // 已到达信号先消费（含同步置位的未决动作）
+
+    if (this.st.phase !== "active") return this.snap(); // paused/blocked/终态不驱动
