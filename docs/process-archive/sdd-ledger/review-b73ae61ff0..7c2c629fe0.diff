+      await r.tick();
+    }
+    expect(r.state().rounds).toBe(8); // 契约 + 7 nudge
+    expect(r.state().injected.length).toBe(6);
+    // 最旧的是第 3 次注入（第 1、2 条被挤出）
+    expect(r.state().injected[0]).toBe(h.transport.injections[2]!.text);
+  });
