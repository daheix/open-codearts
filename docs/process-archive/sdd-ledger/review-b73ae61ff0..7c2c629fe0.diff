+        type: "goal.log",
+        goalId: this.st.goalId,
+        at: now,
+        msg: "plan-observed",
+        items: prog.plan.length,
+      });
+    }
+    if (prog.steps.length > 0) {
+      // 步骤标记出现即视为该步推进：n 号标记把 1..n-1 记为完成（当前步在
+      // 下一步出现时转完成——C++ steps[i].done 同语义）。
+      const done = new Set(this.st.steps);
