+    }
+    // 2) 错误重试到期（C++ tick 第 1 步：到期重试优先，看门狗让路）
+    if (this.pendingRetry !== null && this.retry.shouldRetry(now)) {
+      this.pendingRetry = null;
+      await this.pumpRetryLocked();
+      return this.snap();
+    }
+    // 3) 引导：无会话 → 建会话 + 下发契约（C++ start() 语义并入首 tick）
