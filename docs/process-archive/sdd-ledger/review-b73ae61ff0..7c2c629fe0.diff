+      this.scheduleRetry(kind, now);
+      return;
+    }
+    // 普通输出：会话存活，复位连续失败计数、清错误重试未决（C++ feed 尾段）。
+    if (this.retry.consecutive > 0) this.retry.notifySuccess();
