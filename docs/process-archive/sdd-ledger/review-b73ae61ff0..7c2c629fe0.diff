+/* ───── 注入留痕与轮次 ───── */
+
+describe("注入留痕", () => {
+  it("rounds 随每次注入递增；injected 保留最近 6 条（C++ noteInjection 上限）", async () => {
+    const h = makeHarness();
+    const r = await boot(h);
+    expect(r.state().rounds).toBe(1);
+    for (let i = 0; i < 7; i++) {
