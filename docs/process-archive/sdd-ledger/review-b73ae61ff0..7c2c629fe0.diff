+ * 命中返回类别；未命中返回 null。调用方保证先做注入回显剥离（与 C++ feed 同序）。
+ */
+export function classifyModelError(text: string): ModelErrorKind | null {
+  for (const [kind, re] of MODEL_ERROR_PATTERNS) {
+    if (re.test(text)) return kind;
+  }
+  return null;
+}
