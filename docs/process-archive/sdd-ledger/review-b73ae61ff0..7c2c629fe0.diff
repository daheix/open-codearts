+
+  /* ───── 信号泵与 feed（事件驱动，R-rn1） ───── */
+
+  /** 启动 observe 信号泵：逐信号同步 feed；abort/通道结束即退出。 */
+  private startPump(ref: SessionRef): void {
+    this.pumpAbort = new AbortController();
