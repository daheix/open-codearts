+      type: "goal.log",
+      goalId: this.st.goalId,
+      at: now,
+      msg: "blocked-fatal-error",
+      kind,
+    });
+  }
+
+  /** 错误排程（C++ scheduleRetry 移植；注入动作延后到 tick 统一执行）。 */
