+      method: init.method,
+      authorization: init.headers["Authorization"],
+      contentType: init.headers["Content-Type"],
+      bodyText: init.body,
+    };
+    calls.push(rec);
+    return { status: respond(rec).status, json: async () => respond(rec).body };
