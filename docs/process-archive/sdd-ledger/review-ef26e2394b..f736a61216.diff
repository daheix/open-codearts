+function makeManualLoop(): ManualLoop {
+  let tick: (() => void | Promise<void>) | undefined;
+  const flags = { started: false, stopped: false };
+  return {
+    start(t) {
+      tick = t;
+      flags.started = true;
+    },
+    stop() {
+      flags.stopped = true;
+      tick = undefined;
+    },
+    get started() {
+      return flags.started;
+    },
+    get stopped() {
+      return flags.stopped;
+    },
+    async fire() {
+      await tick?.();
+    },
+  };
+}
