+/** 注入式 fake fetch（捕获 URL/method/头/体；绝不联网）。 */
+function makeFakeDaemon(respond: FakeResponder): { fetcher: DaemonFetcher; calls: RecordedCall[] } {
+  const calls: RecordedCall[] = [];
+  const fetcher: DaemonFetcher = async (url, init) => {
