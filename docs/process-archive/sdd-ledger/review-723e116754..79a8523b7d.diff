+  await rm(TEST_ROOT, { recursive: true, force: true });
+});
+
+/* ───── 防悬挂兜底登记（测试基础设施，非业务兜底）：每个用例结束统一停守护 ───── */
+
+const openDaemons: DaemonHandle[] = [];
+
+afterEach(async () => {
+  while (openDaemons.length > 0) {
