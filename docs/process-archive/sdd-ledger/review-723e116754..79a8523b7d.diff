+/** 等待条件成立（轮询真实事件循环；FakeTransport 注入/观察均为微任务级）。 */
+async function until(cond: () => boolean): Promise<void> {
+  for (let i = 0; i < 500; i++) {
+    if (cond()) return;
+    await new Promise((r) => setTimeout(r, 2));
+  }
+  throw new Error("until 超时：条件未满足");
