+/** 排空微任务管线（观察泵退出/观察槽释放的确定性等待；无真实定时器）。 */
+async function flushMicrotasks(): Promise<void> {
+  for (let round = 0; round < 2; round++) {
+    for (let i = 0; i < 16; i++) await Promise.resolve();
