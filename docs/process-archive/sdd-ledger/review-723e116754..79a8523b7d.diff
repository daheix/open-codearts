+/* ───── 矩阵 7：双过验收——自报 done + verify 失败继续；再成功才 complete ───── */
+
+describe("矩阵7：双过验收", () => {
+  it("verify 首败 → 注入失败原因继续驱动；再次申报 + verify 过 → complete", async () => {
+    const h = await makeHarness({
+      verifyScript: [
