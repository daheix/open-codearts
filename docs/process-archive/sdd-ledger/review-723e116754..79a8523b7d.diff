+
+    // 契约已注入 1 次
+    expect(h.transport.injections.length).toBe(1);
+
+    // 健康端点 actives=1（在册 active 目标数）
+    const health = await fetch(`http://127.0.0.1:${h.port}/health`).then((x) => x.json() as Promise<Record<string, unknown>>);
+    expect(health["actives"]).toBe(1);
