+          return { stdout: "", stderr: "", exitCode: 0 };
+        case "send-keys":
+          return { stdout: "", stderr: "", exitCode: 0 };
+        case "kill-session":
+          exists = false;
+          return { stdout: "", stderr: "", exitCode: 0 };
+        case "capture-pane":
+          return { stdout: pane, stderr: "", exitCode: 0 };
