+#!/usr/bin/env bash
+# fake-tui.sh — codearts TUI 测试替身（T2-02）。
+#
+# 经 script(1) PTY 宿主实跑（test/transport-script.test.ts），行为与真实 TUI
+# 的可观测面一致：文本字符累积缓冲；提交回车触发回显与提交标记。
+#
+# 用法: fake-tui.sh [--scenario stall|error|exit|utf8|family]
+#   默认:   逐字符读 stdin（-icanon，绕过 canonical 行缓冲——行模式无法把
+#           "提交用 \r"与文本行终结区分开）；\r/\n 提交时：缓冲非空 →
+#           打印 "[RX:<buf>]" + "[ENTER]"（两段式提交的两个可观测事件），
+#           缓冲为空（单独 \r）→ 仅 "[ENTER]"；EOF 退出 0。
+#   stall:  静默消费 stdin、永不输出（供 abort/stop 语义测试）。
+#   error:  打印 "[FAKE-ERROR]" 后 exit 3（非零退出场景）。
+#   exit:   打印 "[FAKE-EXIT]" 后 exit 0（自然退出场景）。
+#   utf8:   分两次写入多字节字符"你好"的原始字节（模拟跨 chunk 拆分）后待机。
+#   family: 后台拉起带标记的孙进程（argv[0]=codearts-tree-marker）后待机，
+#           供 stop 全树终止测试（R-p4）经 /proc 扫描核对无残留。
+set -u
+
+scenario="default"
+if [[ $# -ge 2 && "$1" == "--scenario" ]]; then
+  scenario="$2"
+fi
+
+case "$scenario" in
+  stall)
+    # 静默待机：读 stdin 不输出，EOF 退出
+    while IFS= read -r _; do :; done
+    exit 0
+    ;;
+  error)
+    printf '[FAKE-ERROR]\n'
+    exit 3
+    ;;
+  exit)
+    printf '[FAKE-EXIT]\n'
+    exit 0
+    ;;
+  utf8)
+    # "你好" 的 UTF-8 字节拆两半写入（e4 bd a0 / e5 a5 bd），中间留间隔，
+    # 令管道 chunk 边界大概率落在多字节序列中间（StringDecoder 跨 chunk 场景）
+    printf '\xe4\xbd'
+    sleep 0.15
+    printf '\xa0\xe5\xa5\xbd\n'
+    while IFS= read -r _; do :; done
+    exit 0
+    ;;
+  family)
+    # 孙进程：argv[0] 改为唯一标记，便于 /proc 扫描核对（不依赖 sleep 时长断言）
+    bash -c 'exec -a codearts-tree-marker sleep 300' &
+    while IFS= read -r _; do :; done
+    exit 0
+    ;;
+  default)
+    # 逐字符读：关 canonical 行缓冲（stty 作用于本 PTY slave；非 tty 直跑时
+    # 退化为行读——仅影响手动调试，测试恒经 PTY）
+    stty -icanon min 1 time 0 2>/dev/null || :
+    buf=""
+    while IFS= read -r -N 1 ch; do
+      case "$ch" in
+        $'\r' | $'\n')
+          if [[ -n "$buf" ]]; then
+            printf '[RX:%s]\n' "$buf"
+            buf=""
+          fi
+          printf '[ENTER]\n'
+          ;;
+        *)
+          buf+="$ch"
+          ;;
+      esac
+    done
+    exit 0
+    ;;
+esac
diff --git a/plugins/codearts-bridge/test/fixtures/fake-release.ts b/plugins/codearts-bridge/test/fixtures/fake-release.ts
new file mode 100644
index 0000000000..f9894bf264
--- /dev/null
+++ b/plugins/codearts-bridge/test/fixtures/fake-release.ts
@@ -0,0 +1,175 @@
+/**
+ * T1-05 受控升级测试 fixtures（fake Fetcher / 包与布局物料 / content-driven exec / 本地 ustar 构建）。
+ *
+ * 纪律（主控裁定 + 隔离沿用 R-e）：
+ * - 测试绝不联网：Fetcher 全部注入 fake（R-up7）；
+ * - 测试绝不真跑 codearts 二进制：exec 注入"按目标文件内容回答 --version"的
+ *   content-driven fake（fixture 内容嵌入 VERSION=x.y.z 标记，内容决定版本输出，
+ *   与真实二进制"内容决定 --version"的语义同构，且与调用顺序无关）；
+ * - FS 落点由调用方传入的目录派生（约定在插件 .tmp/upgrade-test/ 之下）；
+ * - buildUstarGzip 纯 node:zlib 本地构建，不 spawn tar——真实 tar 进程仅在
+ *   defaultExtract 专项测试出现（系统工具，非 codearts 二进制）。
+ */
+import { createHash } from "node:crypto";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { Buffer } from "node:buffer";
+import { gzipSync } from "node:zlib";
+import * as path from "node:path";
+import type { Exec } from "../../src/core/install";
+import type { Fetcher, Release } from "../../src/core/upgrade";
+
+/* ───── 版本与内容物料（确定性字节串，哈希可复现） ───── */
+
+export const OLD_VERSION = "26.10.9";
+export const NEW_VERSION = "26.11.0";
+
+/** fake fetcher 下发的下载地址（仅测试内约定值，不发起任何真实网络请求）。 */
+export const FAKE_URL = "https://fake.example/codearts-26.11.0.tar.gz";
+
+/** 旧版二进制内容（ELF 魔数 + VERSION 标记；仅 fixture，绝非真二进制）。 */
+export const OLD_ELF_CONTENT = "\x7fELF-fake codearts old payload VERSION=26.10.9\n";
+
+/** 新版二进制内容（正常：版本与 Release.version 一致）。 */
+export const NEW_ELF_CONTENT = "\x7fELF-fake codearts new payload VERSION=26.11.0\n";
+
+/** 新版二进制内容（无 VERSION 标记：自检 --version 无法解析 → PACKAGE_BINARY_INVALID）。 */
+export const NEW_ELF_NO_VERSION = "\x7fELF-fake codearts payload without version marker\n";
+
+/** 新版二进制内容（版本与 Release.version 不符 → PACKAGE_VERSION_MISMATCH）。 */
+export const NEW_ELF_WRONG_VERSION = "\x7fELF-fake codearts payload VERSION=26.99.99\n";
+
+/** 旧版二进制内容（无 VERSION 标记：旧版不可读版本 → from=unknown、备份跳过）。 */
+export const OLD_ELF_NO_VERSION = "\x7fELF-fake codearts old payload no marker\n";
+
+/** 可选脚本（根目录名 codearts、#! 开头 → 一并部署到 <installDir>/codearts）。 */
+export const NEW_SCRIPT_CONTENT = "#!/bin/sh\nprintf 'codearts-wrapper\\n'\n";
+
+/** fake 包字节（哈希校验的载荷；happy path 的 extract 为注入实现，不真解压它）。 */
+export const PACKAGE_BYTES = "fake codearts release package bytes v26.11.0\n";
+
+/** happy path 默认解压布局（R-up5：bin/codearts 为二进制 + 根目录 codearts 脚本）。 */
+export const DEFAULT_LAYOUT: Record<string, string> = {
+  "bin/codearts": NEW_ELF_CONTENT,
+  codearts: NEW_SCRIPT_CONTENT,
+};
+
+/** 测试侧哈希 oracle（独立于被测实现，与 fsx.test.ts 同纪律）。 */
+export function sha256Oracle(content: string): string {
+  return createHash("sha256").update(content, "utf8").digest("hex");
+}
+
+/* ───── fake Fetcher（R-up7：全部注入，绝不联网） ───── */
+
+export interface FakeDownloadRecord {
+  url: string;
+  dest: string;
+}
+
+/**
+ * 构造 fake Fetcher：latest 返回固定 Release（hash 默认与 download 写入字节一致），
+ * download 把包字节写到 dest 并记录调用。可显式给错 hash 构造 HASH_MISMATCH 路径。
+ */
+export function makeFakeFetcher(
+  params: { version?: string; url?: string; hash?: string; bytes?: string } = {},
+  downloads: FakeDownloadRecord[] = [],
+): Fetcher {
+  const bytes = params.bytes ?? PACKAGE_BYTES;
+  const release: Release = {
+    version: params.version ?? NEW_VERSION,
+    url: params.url ?? FAKE_URL,
+    hash: params.hash ?? sha256Oracle(bytes),
+  };
+  return {
+    latest: async () => release,
+    download: async (url: string, dest: string) => {
+      downloads.push({ url, dest });
+      await writeFile(dest, bytes, "utf8");
+    },
+  };
+}
+
+/* ───── 注入式 extract（R-up8：happy path"实为 copy fixture"） ───── */
+
+export interface FakeExtractRecord {
+  pkg: string;
+  destDir: string;
+}
+
+/** 构造注入 extract：把布局物料落进 destDir（模拟解压产物），并记录调用。 */
+export function copyExtract(
+  layout: Record<string, string>,
+  calls: FakeExtractRecord[] = [],
+): (packagePath: string, destDir: string) => Promise<void> {
+  return async (pkg: string, destDir: string): Promise<void> => {
+    calls.push({ pkg, destDir });
+    for (const [rel, content] of Object.entries(layout)) {
+      const target = path.join(destDir, rel);
+      await mkdir(path.dirname(target), { recursive: true });
+      await writeFile(target, content, "utf8");
+    }
+  };
+}
+
+/* ───── content-driven fake exec（绝不真跑二进制） ───── */
+
+/**
+ * 按目标文件内容回答 --version 的 fake exec：
+ * 读 cmd[0] 文件 → 提取 /VERSION=(\d+\.\d+\.\d+)/ → stdout 输出该版本。
+ * 文件缺失/无标记 → 非零退出码（对应真实"无法执行/解析失败"，detectVersion 转 undefined）。
+ */
+export function contentVersionExec(calls: string[][]): Exec {
+  return {
+    run: async (cmd: string[]) => {
+      calls.push(cmd);
+      const target = cmd[0];
+      if (target === undefined) return { code: 1, stdout: "", stderr: "empty cmd" };
+      let text: string;
+      try {
+        text = await readFile(target, "utf8");
+      } catch {
+        return { code: 127, stdout: "", stderr: `cannot open ${target}` };
+      }
+      const match = /VERSION=(\d+\.\d+\.\d+)/.exec(text);
+      if (match === null) return { code: 1, stdout: "", stderr: "no version marker" };
+      return { code: 0, stdout: `${match[1]}\n`, stderr: "" };
+    },
+  };
+}
+
+/* ───── 本地 ustar+gzip 构建（默认解压器专项测试用；不 spawn tar） ───── */
+
+/** 单文件 ustar 头（512 字节；name ≤100 字节，越界显式失败——fixture 自身 bug 立刻暴露）。 */
+function tarHeader(name: string, size: number): Buffer {
+  if (Buffer.byteLength(name, "utf8") > 100) {
+    throw new Error(`fixture tar 文件名超长（ustar 无前缀扩展）：${name}`);
+  }
+  const buf = Buffer.alloc(512, 0);
+  buf.write(name, 0, "utf8");
+  buf.write("0000755\0", 100, "utf8"); // mode
+  buf.write("0000000\0", 108, "utf8"); // uid
+  buf.write("0000000\0", 116, "utf8"); // gid
+  buf.write(`${size.toString(8).padStart(11, "0")}\0`, 124, "utf8"); // size
+  buf.write("00000000000\0", 136, "utf8"); // mtime=0
+  buf.write("        ", 148, "utf8"); // chksum 占位（8 空格参与求和）
+  buf.write("0", 156, "utf8"); // typeflag：常规文件
+  buf.write("ustar\0", 257, "utf8");
+  buf.write("00", 263, "utf8");
+  let sum = 0;
+  for (const byte of buf) sum += byte;
+  buf.write(`${sum.toString(8).padStart(6, "0")}\0 `, 148, "utf8");
+  return buf;
+}
+
+/** 本地构建 gzip 压缩的 ustar（含相对路径文件；父目录由 tar 解压时自动创建）。 */
+export function buildUstarGzip(files: Array<{ rel: string; content: string }>): Buffer {
+  const chunks: Buffer[] = [];
+  for (const file of files) {
+    const data = Buffer.from(file.content, "utf8");
+    chunks.push(tarHeader(file.rel, data.length));
+    chunks.push(data);
+    const pad = (512 - (data.length % 512)) % 512;
+    if (pad > 0) chunks.push(Buffer.alloc(pad, 0));
+  }
+  chunks.push(Buffer.alloc(1024, 0)); // 两块全零结束符
+  return gzipSync(Buffer.concat(chunks));
+}
diff --git a/plugins/codearts-bridge/test/fixtures/install-fixtures.ts b/plugins/codearts-bridge/test/fixtures/install-fixtures.ts
new file mode 100644
index 0000000000..1778967f11
--- /dev/null
+++ b/plugins/codearts-bridge/test/fixtures/install-fixtures.ts
@@ -0,0 +1,146 @@
+/**
+ * T1-03 安装状态探测 fixtures（任务书五种形态 + R-a 未钉版形态）。
+ *
+ * 纪律（主控裁定 R-e）：
+ * - 测试绝不真跑 codearts 二进制（exec 全部注入 fake；真实 exec 测试只用 /bin/sh 脚本）；
+ * - 测试绝不触碰真实 HOME：所有 FS 落点由调用方传入的 root 目录派生
+ *   （约定在插件 .tmp/install-test/ 之下，afterAll 清理）；
+ * - 目录布局模拟真实环境（背景说明）：
+ *     <root>/installers/bin/codearts            二进制
+ *     <root>/installers/bin/codearts.bak-<ver>  备份（codearts.bak-<version> 命名契约）
+ *     <root>/installers/bin/codearts.delete     升级中断残留（only-delete 形态）
+ *     <root>/state/pinned.json                  钉版记录
+ *     <root>/codearts_cli.json                  autoupdate 开关（<installDir>/../codearts_cli.json）
+ */
+import { chmod, mkdir, rm, writeFile } from "node:fs/promises";
+import * as path from "node:path";
+import { sha256File } from "../../src/core/fsx";
+import type { Exec } from "../../src/core/install";
+
+/** 钉版基准版本（真实环境参考值，形如 26.10.9）。 */
+export const PINNED_VERSION = "26.10.9";
+
+/** 基准二进制内容（确定字节串，哈希可复现；仅为探针 fixture，绝非真二进制）。 */
+export const BIN_CONTENT = "fake codearts binary payload v26.10.9\n";
+
+/** 漂移内容（bad-hash 形态：与钉版内容不同 → 哈希漂移）。 */
+export const DRIFT_CONTENT = "fake codearts binary payload v99.0.0 (drifted)\n";
+
+/** fixture 形态（任务书五类 + R-a 未钉版）。 */
+export type InstallFixtureKind =
+  | "healthy" // 二进制在、哈希/版本与钉版一致、备份有效
+  | "missing" // 二进制缺失、备份有效（供 T1-04 repair 使用）
+  | "only-delete" // 二进制缺失只剩 codearts.delete、无备份（Review-Focus-1）
+  | "bad-hash" // 二进制内容哈希与钉版不符（版本输出正常——隔离哈希漂移路径）
+  | "bad-version" // 内容哈希与钉版一致、--version 输出不符（隔离版本漂移路径）
+  | "unpinned"; // 无钉版记录（R-a：未钉版必须与"已钉一致"可区分）
+
+/** fixture 产物（测试据此构造 BridgeConfig 与断言）。 */
+export interface InstallFixture {
+  root: string;
+  installDir: string;
+  stateDir: string;
+  binPath: string;
+  backupPath: string;
+  /** codearts_cli.json 绝对路径（autoupdate 开关载体）。 */
+  cliPath: string;
+  /** 钉版内容（BIN_CONTENT）的 sha256（写入 pinned.json 的期望值）。 */
+  pinnedSha256: string;
+  /** 注入 probeInstall 的 fake exec。 */
+  exec: Exec;
+  /** fake exec 收到的命令记录（断言调用参数/次数）。 */
+  execCalls: string[][];
+}
+
+/** 构造 fake exec：返回固定结果并记录每次调用（绝不执行任何真实进程）。 */
+export function fakeExec(
+  result: { stdout?: string; stderr?: string; code?: number },
+  calls: string[][],
+): Exec {
+  return {
+    run: async (cmd: string[]) => {
+      calls.push(cmd);
+      return { code: result.code ?? 0, stdout: result.stdout ?? "", stderr: result.stderr ?? "" };
+    },
+  };
+}
+
+/** 抛异常的 fake exec（模拟 spawn 层失败：进程起不来）。 */
+export function throwingExec(error: Error): Exec {
+  return { run: async () => Promise.reject(error) };
+}
+
+/**
+ * 搭建 fixture 目录并按 kind 填充。
+ * pinned.json 期望哈希统一从 .expected-content 暂存文件经 sha256File 计算（复用唯一哈希实现，禁止第二实现）。
+ */
+export async function makeInstallFixture(root: string, kind: InstallFixtureKind): Promise<InstallFixture> {
+  const installDir = path.join(root, "installers");
+  const stateDir = path.join(root, "state");
+  const binDir = path.join(installDir, "bin");
+  const binPath = path.join(binDir, "codearts");
+  const backupPath = path.join(binDir, `codearts.bak-${PINNED_VERSION}`);
+  const cliPath = path.join(root, "codearts_cli.json");
+  const execCalls: string[][] = [];
+
+  await mkdir(binDir, { recursive: true });
+  await mkdir(stateDir, { recursive: true });
+
+  // 钉版哈希：经唯一实现 sha256File 从暂存文件计算，随后即删
+  const refPath = path.join(root, ".expected-content");
+  await writeFile(refPath, BIN_CONTENT, "utf8");
+  const pinnedSha256 = await sha256File(refPath);
+  await rm(refPath);
+
+  // 按形态布置 binDir 文件
+  switch (kind) {
+    case "healthy":
+    case "bad-version":
+    case "unpinned":
+      await writeFile(binPath, BIN_CONTENT, "utf8");
+      await writeFile(backupPath, BIN_CONTENT, "utf8");
+      break;
+    case "missing":
+      await writeFile(backupPath, BIN_CONTENT, "utf8");
+      break;
+    case "only-delete":
+      // 升级中断残留：只剩 codearts.delete，无二进制、无备份
+      await writeFile(path.join(binDir, "codearts.delete"), BIN_CONTENT, "utf8");
+      break;
+    case "bad-hash":
+      await writeFile(binPath, DRIFT_CONTENT, "utf8");
+      await writeFile(backupPath, BIN_CONTENT, "utf8");
+      break;
+  }
+
+  // 钉版记录（unpinned 形态不写）
+  if (kind !== "unpinned") {
+    await writePinnedFile(stateDir, { version: PINNED_VERSION, sha256: pinnedSha256 });
+  }
+
+  // autoupdate 开关（默认 false；个别测试自行覆写/删除）
+  await writeFile(cliPath, JSON.stringify({ autoupdate: false }), "utf8");
+
+  // fake exec：--version 输出按形态给定（missing/only-delete 不会被调用）。
+  // 输出契约（R-d）：版本串位于行首（probe 按 /^\d+\.\d+\.\d+/m 行首解析）
+  const versionOutput = kind === "bad-version" ? "99.99.99\n" : `${PINNED_VERSION}\n`;
+  const exec = fakeExec({ stdout: versionOutput }, execCalls);
+
+  return { root, installDir, stateDir, binPath, backupPath, cliPath, pinnedSha256, exec, execCalls };
+}
+
+/** 写 pinned.json（fixtures 与测试共用；格式契约：{"version": string, "sha256": string}）。 */
+export async function writePinnedFile(
+  stateDir: string,
+  record: { version: string; sha256: string },
+): Promise<void> {
+  await mkdir(stateDir, { recursive: true });
+  await writeFile(path.join(stateDir, "pinned.json"), JSON.stringify(record), "utf8");
+}
+
+/** 把 fixture 二进制变为可执行 shell 脚本（仅真实 exec 端到端测试使用；不跑真 codearts）。 */
+export async function makeBinExecutableShScript(binPath: string, versionOutput: string): Promise<void> {
+  // 脚本文件内为字面 \n（sh 的 printf 负责转义为换行），故模板串写 \\n
+  await writeFile(binPath, `#!/bin/sh\nprintf '${versionOutput}\\n'\n`, "utf8");
+  await chmod(binPath, 0o755);
+}
diff --git a/plugins/codearts-bridge/test/fsx.test.ts b/plugins/codearts-bridge/test/fsx.test.ts
new file mode 100644
index 0000000000..a3d6826820
--- /dev/null
+++ b/plugins/codearts-bridge/test/fsx.test.ts
@@ -0,0 +1,232 @@
+/**
+ * T1-03/T1-04 fsx 文件原语测试。
+ *
+ * T1-03（R-b）：sha256File；
+ * T1-04（R-fx1/R-fx2）：sameDevice（st_dev 比较）/ atomicWriteFile（同目录 tmp+rename）/
+ * copyDeploy（同目录 tmp 写全 + fsync + rename 的原子替换部署）。
+ *
+ * 纪律：FS 落点在插件 .tmp/fsx-test/ 之下，beforeEach 重建、afterAll 清理；
+ * 期望哈希用 node:crypto createHash 独立计算（测试侧 oracle，与被测实现分列）。
+ */
+import { afterAll, beforeEach, describe, expect, it } from "bun:test";
+import { createHash } from "node:crypto";
+import { chmod, mkdir, readdir, readFile, rm, stat, writeFile } from "node:fs/promises";
+import * as path from "node:path";
+import { atomicWriteFile, copyDeploy, sameDevice, sha256File } from "../src/core/fsx";
+
+const PLUGIN_ROOT = path.resolve(import.meta.dir, "..");
+const TEST_ROOT = path.join(PLUGIN_ROOT, ".tmp", "fsx-test");
+
+beforeEach(async () => {
+  await rm(TEST_ROOT, { recursive: true, force: true });
+  await mkdir(TEST_ROOT, { recursive: true });
+});
+
+afterAll(async () => {
+  await rm(TEST_ROOT, { recursive: true, force: true });
+});
+
+describe("sha256File", () => {
+  it("小文件哈希与独立 oracle（createHash）一致", async () => {
+    const file = path.join(TEST_ROOT, "small.bin");
+    const content = "fake codearts binary payload v26.10.9\n";
+    await writeFile(file, content, "utf8");
+    const expected = createHash("sha256").update(content, "utf8").digest("hex");
+    expect(await sha256File(file)).toBe(expected);
+    expect(expected).toMatch(/^[0-9a-f]{64}$/);
+  });
+
+  it("空文件哈希为 SHA-256 空串标准值", async () => {
+    const file = path.join(TEST_ROOT, "empty.bin");
+    await writeFile(file, "", "utf8");
+    expect(await sha256File(file)).toBe(
+      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+    );
+  });
+
+  it("大文件（跨流式 chunk，>128KB）哈希正确", async () => {
+    const file = path.join(TEST_ROOT, "large.bin");
+    // 确定性内容拼到 300KB（超过默认 64KB 流 chunk，覆盖多 chunk 聚合路径）
+    const piece = "codearts-bridge-sha256-chunk-boundary-payload-0123456789\n";
+    const content = piece.repeat(Math.ceil(300 * 1024 / piece.length));
+    await writeFile(file, content, "utf8");
+    const expected = createHash("sha256").update(content, "utf8").digest("hex");
+    expect(await sha256File(file)).toBe(expected);
+  });
+
+  it("文件不存在 → 抛 BridgeError(FS_READ_FAILED)，消息含路径与原因", async () => {
+    const file = path.join(TEST_ROOT, "nope.bin");
+    const err: unknown = await sha256File(file).then(
+      () => null,
+      (e: unknown) => e,
+    );
+    expect(err).toBeInstanceOf(Error);
+    expect((err as Error).name).toBe("BridgeError");
+    expect((err as { code?: string }).code).toBe("FS_READ_FAILED");
+    expect((err as Error).message).toContain(file);
+    expect((err as Error).message).toContain("ENOENT");
+  });
+});
+
+describe("sameDevice（st_dev 比较；T1-05 暂存目录选址依据）", () => {
+  it("同目录树下两个路径 → true", async () => {
