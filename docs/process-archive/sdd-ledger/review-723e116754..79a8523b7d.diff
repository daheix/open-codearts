+/**
+ * codearts-bridge 安装管家——安装状态探测（T1-03）与备份自愈修复（T1-04）。
+ *
+ * T1-03 职责：`probeInstall` 只读采集 codearts CLI 安装态：
+ * 二进制存在性 / --version / sha256 / 备份有效性 / autoupdate 开关 / 钉版一致性。
+ *
+ * T1-04 职责（本任务）：
+ * - `repairInstall`：备份发现（期望版本命名 → 扫描 codearts.bak-*）→ 校验
+ *   （哈希 vs 钉版口径 + --version 可执行）→ copyDeploy 原子替换部署 → 复验
+ *   （哈希+版本）→ 审计；可选 `fixAutoupdate` 显式关停自动升级。
+ * - `ensureBackup`：备份是派生物可安全刷新——二进制有效且备份缺失/失效 →
+ *   从二进制 copyDeploy 刷新 `codearts.bak-<版本>` + 审计；二进制无效 → 显式报错。
+ * - 审计（R-fx6）：`<stateDir>/audit/install.jsonl` 追加写，auditId 形如
+ *   `rep-<时间戳>-<随机短码>`。
+ *
+ * 背景事故（remediation 文案依据）：升级流程"先改名（codearts→codearts.delete）
+ * 后部署"，部署失败会静默遗留 .delete 残局；备份命名实例 `codearts.bak-26.10.9`；
+ * 官方接入/升级入口 https://codearts.huaweicloud.com/portal/settings/cli-auth。
+ *
+ * 主控裁定依据（SDD 2026-10-31，逐条落实）：
+ * - R-a 钉版状态显式化：`pinState` 三态（unpinned/consistent/drift）——
+ *   pinned.json 缺失时 drift=false 不得掩盖"未钉版"，调用方以 pinState 区分
+ *   "未钉版"与"已钉且一致"，禁止静默假定。
+ * - R-c autoupdate 读取：路径派生 `<installDir>/../codearts_cli.json`；
+ *   文件缺失 → autoupdateFlag=undefined（显式"未知"）；JSON 解析失败或字段
+ *   类型非法 → 抛出（显式，不静默 undefined）。
+ * - R-d probeInstall 语义：只读状态采集——业务态（缺失/坏哈希/无法执行/版本不符）
+ *   以状态字段如实表达、不抛业务错误；文件系统意外错误（非 ENOENT，如 EACCES）
+ *   → 抛出（消息含路径与原因）。`--version` 解析取输出首个 `/^\d+\.\d+\.\d+/m`
+ *   匹配；exec 失败 → version=undefined（状态可见）。
+ * - R-e 隔离：Exec 注入接口 + 默认 node 实现；测试绝不真跑 codearts 二进制、
+ *   绝不触碰真实 HOME。
+ * - R-fx3 ensureBackup 语义：备份可安全刷新；源二进制无效 → 显式 BridgeError
+ *   （无备份可做，不静默）。
+ * - R-fx4 repair 备份发现顺序与恢复步骤：校验 → copyDeploy → 复验 → 审计；
+ *   全无备份 → BIN_MISSING_NO_BACKUP（remediation 含 .delete 残留检查/官方重装/
+ *   备份恢复指引/官方入口链接）；候选存在但均无效 → BACKUP_INVALID_HASH。
+ * - R-fx5 fixAutoupdate：显式开关（默认不执行）；仅改 autoupdate 字段，
+ *   保留其余字段（含未知字段）；解析失败 → AUTOUPDATE_INVALID 且不触碰文件。
+ *
+ * 漂移判定口径（哈希为内容身份，版本为可读复核）：
+ * - 已钉时：二进制缺失、或 sha256 与钉版不符 → drift；
+ *   版本仅在"可解析且不等"时参与判定（exec 失败导致版本未知不算版本漂移，
+ *   版本未知本身已由 version=undefined 如实呈现）。
+ * - 备份有效性 backupValid：备份存在且为非空常规文件；有钉版时还须哈希与钉版
+ *   一致（修复源强校验），无钉版时仅要求存在且非空（无比对基准）。
+ */
+import { spawn } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { appendFile, readFile, readdir, stat } from "node:fs/promises";
+import type { Stats } from "node:fs";
+import * as path from "node:path";
+import type { BridgeConfig } from "./config";
+import { ensureStateDirs } from "./config";
+import { BridgeError } from "./errors";
+import { atomicWriteFile, copyDeploy, errnoOf, sha256File } from "./fsx";
+
+/* ───── 路径派生（单一出口，T1-04/05 复用） ───── */
+
+/** 二进制绝对路径：<installDir>/bin/codearts。 */
+export function binPathOf(installDir: string): string {
+  return path.join(installDir, "bin", "codearts");
+}
+
+/** 钉版记录路径：<stateDir>/pinned.json。 */
+export function pinnedJsonPath(stateDir: string): string {
+  return path.join(stateDir, "pinned.json");
+}
+
+/** autoupdate 开关载体（R-c）：<installDir>/../codearts_cli.json。 */
+export function codeartsCliJsonPath(installDir: string): string {
+  return path.join(installDir, "..", "codearts_cli.json");
+}
+
+/* ───── Exec 注入接口（R-e） ───── */
+
+/** 子进程执行结果（code 为退出码；被信号杀死时为 -1）。 */
+export interface ExecResult {
+  code: number;
+  stdout: string;
+  stderr: string;
+}
+
+/** 命令执行抽象：测试注入 fake（绝不真跑二进制），生产用 createNodeExec。 */
+export interface Exec {
+  run(cmd: string[]): Promise<ExecResult>;
+}
+
+/** createNodeExec 可调项（超时与输出上限默认值面向 --version 探测量级）。 */
+export interface NodeExecOptions {
+  timeoutMs?: number;
+  maxOutputBytes?: number;
+}
+
+const DEFAULT_TIMEOUT_MS = 10_000;
+const DEFAULT_MAX_OUTPUT_BYTES = 1 << 20; // 1 MiB：--version 输出远小于此
+
+/**
+ * 默认 Exec：node:child_process spawn。
+ *
+ * 显式失败（禁静默兜底）：
+ * - 超时 → BridgeError("EXEC_TIMEOUT")，进程 SIGKILL；
+ * - 输出超限 → BridgeError("EXEC_OUTPUT_OVERFLOW")，进程 SIGKILL（stdout+stderr 合并计数）；
+ * - spawn 层失败（ENOENT/EACCES 等）→ 原样 reject（由 probeInstall 转为
+ *   version=undefined 状态呈现——R-d：无法执行是业务态而非 FS 异常）。
+ */
+export function createNodeExec(opts: NodeExecOptions = {}): Exec {
+  const timeoutMs = opts.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+  const maxOutputBytes = opts.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES;
+  return {
+    run(cmd: string[]): Promise<ExecResult> {
+      return new Promise<ExecResult>((resolve, reject) => {
+        const file = cmd[0];
+        if (file === undefined) {
+          reject(new BridgeError("EXEC_EMPTY_CMD", "exec 命令为空（cmd[0] 缺失）"));
+          return;
+        }
+        const child = spawn(file, cmd.slice(1), { stdio: ["ignore", "pipe", "pipe"] });
+        let stdout = "";
+        let stderr = "";
+        let bytes = 0;
+        let settled = false;
+        let timer: ReturnType<typeof setTimeout> | undefined;
+
+        const settleFail = (err: BridgeError) => {
+          if (settled) return;
+          settled = true;
+          if (timer !== undefined) clearTimeout(timer);
+          child.kill("SIGKILL");
+          reject(err);
+        };
+        const settleResolve = (result: ExecResult) => {
+          if (settled) return;
+          settled = true;
+          if (timer !== undefined) clearTimeout(timer);
+          resolve(result);
+        };
+
+        timer = setTimeout(() => {
+          settleFail(
+            new BridgeError("EXEC_TIMEOUT", `命令超时（>${timeoutMs}ms）已强制终止：cmd=${cmd.join(" ")}`, {
+              remediation: "检查目标二进制是否挂起；若持续超时请上报审计日志",
+            }),
+          );
+        }, timeoutMs);
+
+        // I1 修复（评审裁定）：两流同构——stdout 与 stderr 共用合并计数（头注契约
+        // "stdout+stderr 合并计数"），任一时刻超限 → settleFail(EXEC_OUTPUT_OVERFLOW)
+        // + SIGKILL，与 stdout 原路径完全一致（含单次 settle 守卫）。
+        // 此前 stderr 溢出仅静默截断、从不报错，属禁止的静默兜底。
+        const overflowFail = () =>
+          settleFail(
+            new BridgeError(
+              "EXEC_OUTPUT_OVERFLOW",
+              `命令输出超过上限（>${maxOutputBytes} 字节，stdout+stderr 合并计数）已强制终止：cmd=${cmd.join(" ")}`,
+            ),
+          );
+        /** 合并计数并判定超限；返回 false 表示已溢出（该 chunk 及后续 chunk 一律不拼接）。 */
+        const withinLimit = (chunk: unknown): boolean => {
+          bytes += (chunk as Buffer).length;
+          if (bytes > maxOutputBytes) {
+            overflowFail();
+            return false;
+          }
+          return true;
+        };
+        child.stdout?.on("data", (chunk: unknown) => {
+          if (withinLimit(chunk)) stdout += (chunk as Buffer).toString("utf8");
+        });
+        child.stderr?.on("data", (chunk: unknown) => {
+          if (withinLimit(chunk)) stderr += (chunk as Buffer).toString("utf8");
+        });
+        child.on("error", (e: Error) => {
+          if (settled) return;
+          settled = true;
+          if (timer !== undefined) clearTimeout(timer);
+          reject(e); // spawn 层失败原样上抛（调用方决定语义）
+        });
+        child.on("close", (code) => {
+          settleResolve({ code: code ?? -1, stdout, stderr }); // null=被信号杀死 → -1（非零即可判定失败）
+        });
+      });
+    },
+  };
+}
+
+/* ───── 状态模型 ───── */
+
+/** 钉版记录（pinned.json 内容；本仓库自有格式，写入方为 T1-04/05——
+ *  T1-05 裁定 R-up9 收尾语义不含钉版回写，升级后以 probeInstall 的 drift 口径如实呈现）。 */
+export interface PinnedRecord {
+  version: string;
+  sha256: string;
+}
+
+/**
+ * 钉版一致性三态（R-a：未钉版必须与"已钉一致"可区分，禁止静默假定）：
+ * - "unpinned"：pinned.json 缺失（未钉版）；
+ * - "consistent"：已钉且二进制与钉版一致（哈希相等，版本相等或未知）；
+ * - "drift"：已钉但不一致——二进制缺失、哈希不符、或版本可解析且不等。
+ */
+export type PinState = "unpinned" | "consistent" | "drift";
+
+/** 安装状态（status 工具与守护共用的只读快照）。 */
+export interface InstallStatus {
+  /** 二进制绝对路径 <installDir>/bin/codearts。 */
+  path: string;
+  /** 二进制存在（常规文件）。 */
+  present: boolean;
+  /** --version 解析值（形如 26.10.9）；缺失/无法执行/解析失败 → undefined（R-d 状态呈现）。 */
+  version?: string;
+  /** 二进制内容 sha256（present 时计算）。 */
+  sha256?: string;
+  /**
+   * 规范备份路径 <installDir>/bin/codearts.bak-<version>（命名契约见背景）；
+   * 版本名取 钉版版本 ?? 当前解析版本 ?? "unknown"（未钉且版本未知时的信息性占位，
+   * 此时 backupValid 必为 false，真实状态由字段承载，占位名不参与任何行为）。
+   */
+  backupPath: string;
+  /** 备份可作恢复源：存在且非空常规文件；有钉版时须哈希与钉版一致。 */
+  backupValid: boolean;
+  /** codearts_cli.json 的 autoupdate 字段；文件或键缺失 → undefined（显式未知，R-c）。 */
+  autoupdateFlag?: boolean;
+  /** 钉版一致性三态（R-a）。 */
+  pinState: PinState;
+  /** 便捷字段 = pinState === "drift"（未钉版时 false，靠 pinState 区分）。 */
+  drift: boolean;
+  /** 钉版记录；pinState === "unpinned" 时为 undefined。 */
+  pinned?: PinnedRecord;
+}
+
+/* ───── 内部读取原语（ENOENT 容忍 + 其他错误显式抛） ───── */
+
+/** stat；ENOENT → undefined（显式"不存在"状态）；其他错误 → BridgeError（R-d）。T1-05 升级复用。 */
+export async function statOrEnoent(target: string): Promise<Stats | undefined> {
+  try {
+    return await stat(target);
+  } catch (e) {
+    if (errnoOf(e) === "ENOENT") return undefined;
+    const reason = errnoOf(e) ?? (e instanceof Error ? e.name : "UNKNOWN");
+    throw new BridgeError("FS_STAT_FAILED", `stat 失败：path=${target} reason=${reason}`, {
+      cause: e,
+    });
+  }
+}
+
+/** 读文本；ENOENT → undefined；其他错误 → BridgeError（R-d）。 */
+async function readTextOrEnoent(file: string): Promise<string | undefined> {
+  try {
+    return await readFile(file, "utf8");
+  } catch (e) {
+    if (errnoOf(e) === "ENOENT") return undefined;
+    const reason = errnoOf(e) ?? (e instanceof Error ? e.name : "UNKNOWN");
+    throw new BridgeError("FS_READ_FAILED", `读取文件失败：path=${file} reason=${reason}`, {
+      cause: e,
+    });
+  }
+}
+
+/* ───── 钉版记录读取（自有格式：损坏显式报错） ───── */
+
+const VERSION_FULL_RE = /^\d+\.\d+\.\d+$/;
+const SHA256_HEX_RE = /^[0-9a-fA-F]{64}$/;
+
+/** 读取并校验 pinned.json；缺失 → undefined（未钉版）；损坏/非法 → BridgeError。 */
+async function readPinned(stateDir: string): Promise<PinnedRecord | undefined> {
+  const file = pinnedJsonPath(stateDir);
+  const text = await readTextOrEnoent(file);
+  if (text === undefined) return undefined;
+
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text);
+  } catch (e) {
+    throw new BridgeError("PINNED_INVALID", `钉版记录 JSON 解析失败：path=${file}`, {
+      remediation: "修正或删除 pinned.json（删除即视为未钉版状态）",
+      cause: e,
+    });
+  }
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new BridgeError("PINNED_INVALID", `钉版记录须为 JSON 对象：path=${file}`);
+  }
+  const record = raw as Record<string, unknown>;
+  for (const key of Object.keys(record)) {
+    if (key !== "version" && key !== "sha256") {
+      throw new BridgeError("PINNED_INVALID", `钉版记录含未知键 "${key}"（仅允许 version/sha256）：path=${file}`);
+    }
+  }
+  const version = record.version;
+  if (typeof version !== "string" || !VERSION_FULL_RE.test(version)) {
+    throw new BridgeError("PINNED_INVALID", `钉版记录 version 须为 \\d+\\.\\d+\\.\\d+ 形态：path=${file}`);
+  }
+  const sha256 = record.sha256;
+  if (typeof sha256 !== "string" || !SHA256_HEX_RE.test(sha256)) {
+    throw new BridgeError("PINNED_INVALID", `钉版记录 sha256 须为 64 位十六进制：path=${file}`);
+  }
+  return { version, sha256: sha256.toLowerCase() };
+}
+
+/* ───── autoupdate 开关读取（R-c：外来用户文件，只检目标字段） ───── */
+
+/**
+ * 读取 codearts_cli.json 的 autoupdate 字段。
+ * - 文件缺失 → undefined（显式未知）；
+ * - JSON 解析失败 / 顶层非对象 / autoupdate 字段类型非法 → 抛出（R-c 显式）；
+ * - 外来文件的其他键一律不校验（只检目标字段，非兜底）。
+ */
+async function readAutoupdateFlag(installDir: string): Promise<boolean | undefined> {
+  const file = codeartsCliJsonPath(installDir);
+  const text = await readTextOrEnoent(file);
+  if (text === undefined) return undefined;
+
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text);
+  } catch (e) {
+    throw new BridgeError("AUTOUPDATE_INVALID", `codearts_cli.json 解析失败：path=${file}`, {
+      remediation: "修正该文件的 JSON 语法（该文件属 codearts CLI 用户配置）",
+      cause: e,
+    });
+  }
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    throw new BridgeError("AUTOUPDATE_INVALID", `codearts_cli.json 顶层须为 JSON 对象：path=${file}`);
+  }
+  if (!("autoupdate" in raw)) return undefined;
+  const flag = (raw as Record<string, unknown>).autoupdate;
+  if (typeof flag !== "boolean") {
+    throw new BridgeError(
+      "AUTOUPDATE_INVALID",
+      `codearts_cli.json 的 autoupdate 字段类型非法（须为布尔）：path=${file}`,
+    );
+  }
+  return flag;
+}
+
+/* ───── --version 探测与备份检查 ───── */
+
+/** 版本解析（R-d）：取输出首个 `/^\d+\.\d+\.\d+/m` 匹配；stdout 优先、stderr 兜扫（版本串可能出现在任一流）。 */
+const VERSION_PREFIX_RE = /^\d+\.\d+\.\d+/m;
+
+/**
+ * 执行 `<bin> --version` 并解析版本。
+ * - 退出码非 0 → undefined（exec 失败，R-d）；
+ * - exec 抛错（spawn 层 ENOENT/EACCES 等）→ undefined（无法执行是业务态，R-d）；
+ * - 两流均无版本形串 → undefined（解析失败）。
+ * T1-05 升级复用（新二进制自检/部署复验共用同一版本解析口径）。
+ */
+export async function detectVersion(exec: Exec, binPath: string): Promise<string | undefined> {
+  let result: ExecResult;
+  try {
+    result = await exec.run([binPath, "--version"]);
+  } catch {
+    return undefined;
+  }
+  if (result.code !== 0) return undefined;
+  const match = VERSION_PREFIX_RE.exec(result.stdout) ?? VERSION_PREFIX_RE.exec(result.stderr);
+  return match?.[0];
+}
+
+/**
+ * 备份有效性检查：存在且为非空常规文件；有钉版时哈希须与钉版一致。
+ * - ENOENT → false（无备份是显式状态）；
+ * - 存在但非常规文件 → 抛 BridgeError（异常态，禁止静默当 false）；
+ * - 哈希读取失败（非 ENOENT FS 错误）→ 经 sha256File 显式抛出。
+ */
+async function checkBackup(backupPath: string, pin: PinnedRecord | undefined): Promise<boolean> {
+  const st = await statOrEnoent(backupPath);
+  if (st === undefined) return false;
+  if (!st.isFile()) {
+    throw new BridgeError("FS_PATH_NOT_FILE", `备份路径存在但不是常规文件：path=${backupPath}`, {
+      remediation: "检查备份文件是否被外部改动；可执行 codearts_repair 重建备份",
+    });
+  }
+  if (st.size === 0) return false; // 空备份无恢复价值：显式规则，非兜底
+  if (pin === undefined) return true; // 无钉版：无比对基准，存在且非空即可（backupValid 语义见头注）
+  return (await sha256File(backupPath)) === pin.sha256;
+}
+
+/* ───── probeInstall ───── */
+
+/**
+ * 只读探测安装状态（R-d）。绝不写任何文件、绝不删除残留（清理属 T1-04/T1-05）。
+ *
+ * @param cfg  全局配置（消费 installDir 与 stateDir）
+ * @param deps 可注入依赖；exec 缺省用 createNodeExec（测试注入 fake）
+ */
+export async function probeInstall(
+  cfg: BridgeConfig,
+  deps: { exec?: Exec } = {},
+): Promise<InstallStatus> {
+  const exec = deps.exec ?? createNodeExec();
+  const binPath = binPathOf(cfg.installDir);
+
+  // 1) 二进制存在性与内容/版本（缺失是显式状态；存在但非常规文件是异常态 → 抛）
+  let present = false;
+  let sha256: string | undefined;
+  let version: string | undefined;
+  const binStat = await statOrEnoent(binPath);
+  if (binStat !== undefined) {
+    if (!binStat.isFile()) {
+      throw new BridgeError("FS_PATH_NOT_FILE", `二进制路径存在但不是常规文件：path=${binPath}`, {
+        remediation: "检查安装目录是否被外部改动；可执行 codearts_repair 重建",
+      });
+    }
+    present = true;
+    sha256 = await sha256File(binPath);
+    version = await detectVersion(exec, binPath);
+  }
+
+  // 2) 钉版记录与 autoupdate 开关
+  const pin = await readPinned(cfg.stateDir);
+  const autoupdateFlag = await readAutoupdateFlag(cfg.installDir);
+
+  // 3) 备份（命名契约 codearts.bak-<version>；版本名来源按头注优先级）
+  const backupName = pin?.version ?? version ?? "unknown";
+  const backupPath = path.join(cfg.installDir, "bin", `codearts.bak-${backupName}`);
+  const backupValid = await checkBackup(backupPath, pin);
+
+  // 4) 钉版一致性（R-a 三态；漂移口径见头注：版本未知不判版本漂移）
+  let pinState: PinState;
+  if (pin === undefined) {
+    pinState = "unpinned";
+  } else if (present && sha256 === pin.sha256 && (version === undefined || version === pin.version)) {
+    pinState = "consistent";
+  } else {
+    pinState = "drift";
+  }
+
+  return {
+    path: binPath,
+    present,
+    version,
+    sha256,
+    backupPath,
+    backupValid,
+    autoupdateFlag,
+    pinState,
+    drift: pinState === "drift",
+    pinned: pin,
+  };
+}
+
+/* ───── 审计（R-fx6：install.jsonl 追加写） ───── */
+
+/** auditId 形如 rep-<epoch 毫秒>-<6 位随机十六进制>（R-fx6）。 */
+function newRepairAuditId(): string {
+  return `rep-${Date.now()}-${randomBytes(3).toString("hex")}`;
+}
+
+/**
+ * 追加一条审计到 <stateDir>/audit/install.jsonl（R-fx6）。
+ * 先 ensureStateDirs（audit/ 目录 0700）；追加失败显式抛 FS_WRITE_FAILED（含路径）。
+ * T1-05 升级审计复用同一出口（install 管理动作共用单一审计流，便于对账）。
+ */
+export async function appendInstallAudit(cfg: BridgeConfig, entry: Record<string, unknown>): Promise<void> {
+  await ensureStateDirs(cfg);
+  const file = path.join(cfg.stateDir, "audit", "install.jsonl");
+  try {
+    await appendFile(file, `${JSON.stringify(entry)}\n`, "utf8");
+  } catch (e) {
+    const reason = errnoOf(e) ?? (e instanceof Error ? e.name : "UNKNOWN");
+    throw new BridgeError("FS_WRITE_FAILED", `追加审计失败：path=${file} reason=${reason}`, {
+      cause: e,
+    });
+  }
+}
+
+/* ───── 备份候选发现与校验（R-fx4） ───── */
+
+/** 备份命名契约：bin 同目录下 codearts.bak-<任意后缀>（实例 codearts.bak-26.10.9）。 */
+const BACKUP_NAME_RE = /^codearts\.bak-.+/;
+
+/** 备份候选校验结果：ok 时携带内容哈希与可读版本；失败时携带机器可读原因。 */
+type BackupValidation =
+  | { ok: true; sha256: string; version: string }
+  | { ok: false; reason: string };
+
+/**
+ * 校验单个备份候选（R-fx4 恢复步骤第 1 步）：
+ * - 存在且为非空常规文件（与 T1-03 backupValid 口径一致）；
+ * - 哈希校验："备份自身记录口径"= 有钉版时 sha256 须与钉版一致（内容身份），
+ *   无钉版时无比对基准（仅要求非空常规文件）；
+ * - `--version` 可执行且可解析（备份必须能跑起来才有恢复价值）。
+ * 单个候选的 stat/读取失败按"该候选无效"记录原因并继续（候选枚举容错：
+ * 扫描目录里可能有垃圾件，不应让单个坏候选中断整个发现过程；
+ * 全部无效时由调用方汇总原因显式报错，无静默）。
+ */
+async function validateBackupCandidate(
+  backupPath: string,
+  pin: PinnedRecord | undefined,
+  exec: Exec,
+): Promise<BackupValidation> {
+  let st: Stats | undefined;
+  try {
+    st = await statOrEnoent(backupPath);
+  } catch (e) {
+    return { ok: false, reason: `stat-failed(${e instanceof Error ? e.message : String(e)})` };
+  }
+  if (st === undefined) return { ok: false, reason: "missing" };
+  if (!st.isFile()) return { ok: false, reason: "not-file" };
+  if (st.size === 0) return { ok: false, reason: "empty" };
+
+  let sha: string;
+  try {
+    sha = await sha256File(backupPath);
+  } catch (e) {
+    return { ok: false, reason: `read-failed(${e instanceof Error ? e.message : String(e)})` };
+  }
+  if (pin !== undefined && sha !== pin.sha256) return { ok: false, reason: "hash-mismatch" };
+
+  const version = await detectVersion(exec, backupPath);
+  if (version === undefined) return { ok: false, reason: "not-runnable" };
+  return { ok: true, sha256: sha, version };
+}
+
+/** 列出 bin 目录文件名；目录不存在 → 空数组（无候选是显式状态）；其他错误显式抛。 */
+async function listBinDirNames(binDir: string): Promise<string[]> {
+  try {
+    return await readdir(binDir);
+  } catch (e) {
+    if (errnoOf(e) === "ENOENT") return [];
+    const reason = errnoOf(e) ?? (e instanceof Error ? e.name : "UNKNOWN");
+    throw new BridgeError("FS_READ_FAILED", `读取目录失败：path=${binDir} reason=${reason}`, {
+      cause: e,
+    });
+  }
+}
+
+/** 当前二进制的可读版本（仅 present 且为常规文件时探测；否则 undefined）。 */
+async function currentBinVersion(exec: Exec, binPath: string): Promise<string | undefined> {
+  const st = await statOrEnoent(binPath);
+  if (st === undefined || !st.isFile()) return undefined;
+  return detectVersion(exec, binPath);
+}
+
+/** BIN_MISSING_NO_BACKUP 的统一出口：remediation 含真实事故四要素（R-fx4）。 */
+function noBackupError(binPath: string, binDir: string): BridgeError {
+  return new BridgeError(
+    "BIN_MISSING_NO_BACKUP",
+    `二进制缺失且找不到任何可用备份：bin=${binPath} binDir=${binDir}`,
+    {
+      remediation:
+        `1) 检查 ${binDir} 下是否存在 codearts.delete 等升级中断残留` +
+        `（升级流程"先改名后部署"，部署失败会遗留 .delete 残局）；` +
+        `2) 从官方安装包重装 codearts CLI；` +
+        `3) 若其他位置留有 codearts.bak-* 备份，手工复制到 ${binDir}/codearts.bak-<版本> 后重试恢复；` +
+        `4) 官方接入/升级入口：https://codearts.huaweicloud.com/portal/settings/cli-auth`,
+    },
+  );
+}
+
+/* ───── repairInstall（T1-04 核心：备份恢复自愈） ───── */
+
+/** 修复结果（任务书接口）：action 固定 restore-from-backup，from 显式记录所用备份文件名。 */
+export interface RepairResult {
+  action: "restore-from-backup";
+  from: string;
+  to: string;
+  sha256: string;
+  auditId: string;
+}
+
+/**
+ * 自愈修复（R-fx4）：从备份恢复二进制，可选显式关停 autoupdate。
+ *
+ * 执行顺序：
+ * 1. fixAutoupdate=true 时先关停自动升级（止血优先：即便恢复失败，
+ *    也不再被自动升级破坏；该动作独立审计，幂等可重试）；
+ * 2. 备份发现（R-fx4 顺序）：① `<bin>.bak-<期望版本>`（期望版本=钉版版本，
+ *    未钉版取当前二进制 probe 版本）→ ② 扫描 `codearts.bak-*` 取任一有效备份；
+ * 3. 逐候选校验（哈希 vs 钉版口径 + --version 可执行），取首个有效者；
+ * 4. copyDeploy 原子替换部署（R-fx1：目标要么旧内容要么新内容）；
+ * 5. 复验（哈希 vs 钉版/备份基线 + --version 可执行）；
+ * 6. 审计（kind=repair，含 auditId）并返回 RepairResult。
+ *
+ * 失败分支（显式，无静默）：
+ * - 无任何候选 → BIN_MISSING_NO_BACKUP（remediation 四要素，见 noBackupError）；
+ * - 候选存在但全部无效（含哈希不符）→ BACKUP_INVALID_HASH；
+ * - 部署后复验不过 → REPAIR_VERIFY_FAILED（不谎报成功）；
+ * - FS/权限失败 → FS_WRITE_FAILED（含路径与 errno，见 copyDeploy）。
+ */
+export async function repairInstall(
+  cfg: BridgeConfig,
+  exec: Exec,
+  opts: { fixAutoupdate?: boolean } = {},
+): Promise<RepairResult> {
+  // 1) 显式开关（R-fx5）：默认不执行；开启才修正 autoupdate
+  if (opts.fixAutoupdate === true) {
+    await fixAutoupdateFlag(cfg);
+  }
+
+  const binPath = binPathOf(cfg.installDir);
+  const binDir = path.dirname(binPath);
+  const pin = await readPinned(cfg.stateDir);
+
+  // 2) 候选发现：期望版本命名优先，其次扫描 codearts.bak-*
+  const candidates: string[] = [];
+  const expectedVersion = pin?.version ?? (await currentBinVersion(exec, binPath));
+  if (expectedVersion !== undefined) {
+    candidates.push(path.join(binDir, `codearts.bak-${expectedVersion}`));
+  }
+  const seen = new Set(candidates);
+  for (const name of (await listBinDirNames(binDir)).sort()) {
+    if (!BACKUP_NAME_RE.test(name)) continue;
+    const full = path.join(binDir, name);
+    if (!seen.has(full)) {
+      seen.add(full);
+      candidates.push(full);
+    }
+  }
+
+  // 3) 逐候选校验，取首个有效备份；全无效则按是否含哈希不符细分错误码。
+  //    "候选名不存在"是正常态（期望版本名没有对应备份），不计入失败候选——
+  //    只有真实存在的候选文件全部无效才算"有备份但都坏"（否则 only-delete
+  //    残局会误报 BACKUP_INVALID 而非 BIN_MISSING_NO_BACKUP）。
+  const failures: string[] = [];
+  let sawHashMismatch = false;
+  let existingCount = 0;
+  let chosen: { path: string; sha256: string; version: string } | undefined;
+  for (const candidate of candidates) {
+    const verdict = await validateBackupCandidate(candidate, pin, exec);
+    if (verdict.ok) {
+      chosen = { path: candidate, sha256: verdict.sha256, version: verdict.version };
+      break;
+    }
+    if (verdict.reason === "missing") continue;
+    existingCount++;
+    if (verdict.reason === "hash-mismatch") sawHashMismatch = true;
+    failures.push(`${candidate}: ${verdict.reason}`);
+  }
+  if (chosen === undefined) {
+    if (existingCount === 0) throw noBackupError(binPath, binDir);
+    if (sawHashMismatch) {
+      throw new BridgeError(
+        "BACKUP_INVALID_HASH",
+        `所有候选备份均无效（含哈希与钉版不符）：${failures.join("; ")}`,
+        { remediation: "备份文件已损坏：从官方安装包重装，或提供与钉版记录一致的备份后重试" },
+      );
+    }
+    throw new BridgeError(
+      "BACKUP_INVALID",
+      `所有候选备份均无效（非常规文件/为空/不可执行）：${failures.join("; ")}`,
+      { remediation: "备份不可执行无恢复价值：从官方安装包重装后重试" },
+    );
+  }
+
+  // 4) 原子替换部署（R-fx1；mode 默认 0755）
+  await copyDeploy(chosen.path, binPath, 0o755);
+
+  // 5) 复验（哈希+版本）：哈希基线=钉版 ?? 所用备份内容；版本须可解析（可读复核）
+  const expectedSha = pin?.sha256 ?? chosen.sha256;
+  const deployedSha = await sha256File(binPath);
+  const deployedVersion = await detectVersion(exec, binPath);
+  if (deployedSha !== expectedSha || deployedVersion === undefined) {
+    throw new BridgeError(
+      "REPAIR_VERIFY_FAILED",
+      `恢复后复验失败：bin=${binPath} sha256 一致=${deployedSha === expectedSha} 版本可解析=${deployedVersion !== undefined}`,
+      { remediation: "恢复部署未通过复验：检查备份文件与磁盘状态后重试，或从官方安装包重装" },
+    );
+  }
+
+  // 6) 审计 + 返回（auditId 显式回传调用方，可跨系统对账）
+  const auditId = newRepairAuditId();
+  await appendInstallAudit(cfg, {
+    ts: new Date().toISOString(),
+    auditId,
+    kind: "repair",
+    from: chosen.path,
+    to: binPath,
+    sha256: deployedSha,
+    result: "restored",
+  });
+  return { action: "restore-from-backup", from: chosen.path, to: binPath, sha256: deployedSha, auditId };
+}
+
+/* ───── fixAutoupdate（R-fx5：显式开关修正） ───── */
+
+/**
+ * 把 codearts_cli.json 的 autoupdate 修正为 false（R-fx5）：
+ * - 解析失败 / 顶层非对象 → BridgeError(AUTOUPDATE_INVALID)，不触碰文件；
+ * - 文件缺失 → 视为空对象，写入仅含 autoupdate:false 的新文件（显式动作，
+ *   审计 before=null 记录"原本缺失"）；
+ * - 仅改 autoupdate 字段，其余字段（含未知字段）原样保留；
+ * - 写回格式：JSON.stringify(obj, null, 2) + 末尾换行（R-fx5 指定）；
+ * - 已存在文件保留原 mode（外来用户文件不越权改权限），新建用 0644；
+ * - 已是 false → 幂等不重写，审计记录 already-off。
+ *
+ * T1-08 共享导出说明：工具层（server.ts）的 already-healthy 幂等路径需要在
+ * 不走 repairInstall 的前提下响应显式 fixAutoupdate 请求（R-t3：fixAutoupdate
+ * 透传，健康短路不得丢弃用户显式动作），故本函数自 T1-08 起对外导出；
+ * 语义不变：显式开关、幂等、独立审计。
+ */
+export async function fixAutoupdateFlag(cfg: BridgeConfig): Promise<void> {
+  const file = codeartsCliJsonPath(cfg.installDir);
+
+  let text: string | undefined;
+  try {
+    text = await readFile(file, "utf8");
+  } catch (e) {
+    if (errnoOf(e) !== "ENOENT") {
+      const reason = errnoOf(e) ?? (e instanceof Error ? e.name : "UNKNOWN");
+      throw new BridgeError("FS_READ_FAILED", `读取文件失败：path=${file} reason=${reason}`, {
+        cause: e,
+      });
+    }
+    text = undefined; // 缺失是显式状态（与 probe 的 autoupdateFlag=undefined 同口径）
+  }
+
+  let raw: Record<string, unknown>;
+  if (text === undefined) {
+    raw = {};
+  } else {
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(text);
+    } catch (e) {
+      throw new BridgeError("AUTOUPDATE_INVALID", `codearts_cli.json 解析失败：path=${file}`, {
+        remediation: "修正该文件的 JSON 语法（该文件属 codearts CLI 用户配置）",
+        cause: e,
+      });
+    }
+    if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+      throw new BridgeError("AUTOUPDATE_INVALID", `codearts_cli.json 顶层须为 JSON 对象：path=${file}`);
+    }
+    raw = parsed as Record<string, unknown>;
+  }
+
+  const before = raw["autoupdate"]; // 可能缺失/布尔/其他类型；repair 一律规整为 false
+  const auditId = newRepairAuditId();
+
+  if (text !== undefined && before === false) {
+    // 幂等：已是 false 无需写；审计照记（审计是"动作发生过"的台账，非"值变化"的台账）
+    await appendInstallAudit(cfg, {
+      ts: new Date().toISOString(),
+      auditId,
+      kind: "fix-autoupdate",
+      file,
+      before: false,
+      after: false,
+      changed: false,
+      result: "already-off",
+    });
+    return;
+  }
+
+  raw["autoupdate"] = false;
+  const mode =
+    text !== undefined ? (await stat(file)).mode & 0o777 : 0o644; // 保留原权限；新建 0644
+  await atomicWriteFile(file, `${JSON.stringify(raw, null, 2)}\n`, mode);
+  await appendInstallAudit(cfg, {
+    ts: new Date().toISOString(),
+    auditId,
+    kind: "fix-autoupdate",
+    file,
+    before: before === undefined ? null : before,
+    after: false,
+    changed: true,
+    result: "fixed",
+  });
+}
+
+/* ───── ensureBackup（R-fx3：备份是派生物，可安全刷新） ───── */
+
+/**
+ * 确保备份在场且新鲜（R-fx3）：
+ * - 备份源有效性显式校验（禁静默）：存在 + 非空常规文件 + `--version` 可执行；
+ *   有钉版时哈希须与钉版一致——拒绝把漂移内容固化为备份；
+ * - 目标 `codearts.bak-<版本>`（版本名=钉版版本 ?? 当前解析版本；
+ *   源有效性校验已保证版本可解析，"unknown" 占位名在此路径不可能出现）；
+ * - 备份已与当前二进制一致（哈希相等）→ 不重写（派生物幂等），审计 up-to-date；
+ * - 缺失/失效 → copyDeploy 刷新（原子替换），审计 refreshed。
+ *
+ * 审计字段（R-fx6）：{ ts, auditId, kind:"ensure-backup", from, to, sha256, result }。
+ */
+export async function ensureBackup(cfg: BridgeConfig, exec: Exec): Promise<void> {
+  const binPath = binPathOf(cfg.installDir);
+  const pin = await readPinned(cfg.stateDir);
+
+  // 源有效性：缺失/非常规文件/空文件 → 显式报错（无备份可做，不静默）
+  const st = await statOrEnoent(binPath);
+  if (st === undefined || !st.isFile() || st.size === 0) {
+    throw new BridgeError("BACKUP_SOURCE_INVALID", `备份源无效（缺失/非常规文件/空文件）：path=${binPath}`, {
+      remediation: "先执行 codearts_repair 从备份恢复二进制，或从官方安装包重装后再试",
+    });
+  }
+  const version = await detectVersion(exec, binPath);
+  if (version === undefined) {
+    throw new BridgeError("BACKUP_SOURCE_INVALID", `备份源不可执行（--version 无有效输出）：path=${binPath}`, {
+      remediation: "不可执行的二进制无备份价值：先执行 codearts_repair 修复，或从官方安装包重装",
+    });
+  }
+  const sha = await sha256File(binPath);
+  if (pin !== undefined && sha !== pin.sha256) {
+    throw new BridgeError(
+      "BACKUP_SOURCE_INVALID",
+      `备份源 sha256 与钉版记录不符，拒绝把漂移内容固化为备份：path=${binPath}`,
+      { remediation: "先执行 codearts_repair 恢复与钉版一致的内容，再刷新备份" },
+    );
+  }
+
+  const backupPath = path.join(path.dirname(binPath), `codearts.bak-${pin?.version ?? version}`);
+  const auditId = newRepairAuditId();
+
+  // 已在场且与当前二进制一致 → 不重写（mtime 不变）
+  const existing = await statOrEnoent(backupPath);
+  if (existing !== undefined && existing.isFile() && existing.size > 0 && (await sha256File(backupPath)) === sha) {
+    await appendInstallAudit(cfg, {
+      ts: new Date().toISOString(),
+      auditId,
+      kind: "ensure-backup",
+      from: binPath,
+      to: backupPath,
+      sha256: sha,
+      result: "up-to-date",
+    });
+    return;
+  }
+
+  await copyDeploy(binPath, backupPath, 0o755);
+  await appendInstallAudit(cfg, {
+    ts: new Date().toISOString(),
+    auditId,
+    kind: "ensure-backup",
+    from: binPath,
+    to: backupPath,
+    sha256: sha,
+    result: "refreshed",
+  });
+}
diff --git a/plugins/codearts-bridge/src/core/run.ts b/plugins/codearts-bridge/src/core/run.ts
new file mode 100644
index 0000000000..983c40eea9
--- /dev/null
+++ b/plugins/codearts-bridge/src/core/run.ts
@@ -0,0 +1,472 @@
+/**
+ * codearts_run 编排核心（T2-05）：传输选择 + 单轮运行 + 进度/取消 + 审计。
+ *
+ * 职责边界：server.ts 的 codearts_run 工具是薄编排（参数归一 → 本模块 → 结构化
+ * 返回）；传输选择、会话生命期、超时/取消语义、审计写盘的业务判断全部在本文件。
+ *
+ * 主控裁定落点（2026-10-31，逐条）：
+ * - R-cr1（auto 传输选择显式）：selectTransport 纯函数——cfg.transport=auto 时
+ *   structured 当且仅当 readAksk 有凭据（AK/SK 齐备非空）；否则 pty（ptyHost
+ *   显式 tmux/script 直接采用；auto 经 tmux 可用性探测二选一）。显式 transport
+ *   值优先。结果必含 {mode, reason}（无静默切换）；探测输入（hasAksk/
+ *   tmuxAvailable）由 runOnce 异步解析后传入，选择逻辑本身保持纯函数可测。
+ * - R-cr2（超时语义）：timeoutMs 到 → delay 定时触发 → ctrl.abort() → 观察循环
+ *   终止 → transport.stop() + 返回结构化超时结果（status="timeout"，含已捕获
+ *   输出摘要）。非静默、非错误——调用方可见"超时中断"事实。
+ * - R-cr3（进度与取消）：progress 在注入后至少更新一次；其后按信号批次 + 2s
+ *   节流更新（clock 注入，测试确定性）；context.signal abort → 停止观察并
+ *   transport.stop()（对齐 types.ts T9 abort 语义：立即放弃、残存不交付）。
+ * - R-cr4（审计）：run.start / run.exit 成对写 audit/install.jsonl（经
+ *   appendInstallAudit），含 mode/reason/session/prompt 摘要/结果摘要；prompt
+ *   全文不入审计——只记长度与前 80 字符。run.start 审计失败 → 停止会话并显式
+ *   报错（禁止无审计的运行）；run.exit 审计失败不掩盖运行结果（R-t1 同纪律，
+ *   run.start 已留痕，部署级写故障由 health/审计监控暴露）。
+ * - 错误路径（任务书 Step1）：error 信号经 classifyError 分级，任一 retryable
+ *   → 结果 retryable=true 并附摘要；**不静默重试**——重试属目标引擎（T3 监督
+ *   状态机）职责。transport 抛出的 BridgeError 原样上抛（工具层 R-t1 转
+ *   结构化 content），run.exit 审计以 status="error" 留痕。
+ *
+ * 修复环第 1 轮（2026-10-31，主控裁定/I-M48/I-M50）：
+ * - M48 预 abort 短路：start/审计完成后 ctrl.signal 已 aborted → inject 零调用
+ *   （已取消的 prompt 不写入目标会话），照常 stop + cancelled 结果。
+ * - M50 error 路径审计对齐：run.exit(status="error") 补 outputBytes/summary/
+ *   retryable，与成功路径 schema 一致（审计消费方单一 schema）。
+ *
+ * 终态语义（status 四值，均为结构化结果非错误）：
+ * - "completed"：观察到 done 信号（PTY 宿主进程退出 / structured 回合 exit=0）；
+ * - "timeout"：timeoutMs 到（R-cr2，已 stop）；
+ * - "cancelled"：宿主 signal abort（R-cr3，已 stop）；
+ * - "ended"：事件流结束但无 done、无超时、无取消（如 structured 回合失败退出
+ *   ——R-s4 错误回合不宣告会话死亡，会话保活可续接；错误事实在 errors/summary）。
+ * 优先级：completed > timeout > cancelled > ended（done 是最强完成事实）。
+ * 超时/取消/错误路径必 stop；completed/ended 不 stop（structured 会话保活供
+ * 续接；PTY 宿主 done 即进程已退，stop 幂等无意义）。
+ */
+
+import { randomUUID } from "node:crypto";
+import type { BridgeConfig } from "./config";
+import { readAksk } from "./config";
+import { BridgeError } from "./errors";
+import { appendInstallAudit } from "./install";
+import { createScriptTransport, nodeScriptSpawnPty } from "./transport/pty-script";
+import { createTmuxTransport, nodeTmuxExec } from "./transport/pty-tmux";
+import { classifyError, createStructuredTransport, nodeRunSpawnProc } from "./transport/structured";
+import type { CodeartsTransport, ObserveOptions, SessionRef } from "./transport/types";
+
+/* ───── 常量（口径唯一真相源，测试钉死） ───── */
+
+/** 缺省超时（毫秒）：M2 真机冒烟口径 ≤120s 的上限同源。 */
+export const RUN_DEFAULT_TIMEOUT_MS = 120_000;
+
+/** 捕获输出摘要上限（字符数；超出取尾部并加省略号前缀）。 */
+export const RUN_SUMMARY_MAX_CHARS = 500;
+
+/** 进度节流窗口（毫秒；R-cr3"每 2s 或每信号批次"）。 */
+export const RUN_PROGRESS_THROTTLE_MS = 2_000;
+
+/** 审计中 prompt 预览长度（字符数；R-cr4"只记长度与前 80 字符"）。 */
+export const RUN_PROMPT_PREVIEW_CHARS = 80;
+
+/* ───── R-cr1：传输选择（纯函数） ───── */
+
+/** 实际使用的传输模式（pty 细分宿主）。 */
+export type RunTransportMode = "structured" | "pty-tmux" | "pty-script";
+
+/** 传输选择结果：mode + 人类可读原因（无静默切换）。 */
+export interface TransportSelection {
+  mode: RunTransportMode;
+  reason: string;
+}
+
+/** selectTransport 输入（异步探测解析后的纯数据）。 */
+export interface SelectTransportInput {
+  transport: BridgeConfig["transport"];
+  ptyHost: BridgeConfig["ptyHost"];
+  /** AK/SK 凭据齐备（AK 与 SK 均非空）。 */
+  hasAksk: boolean;
+  /** tmux 可用（仅 ptyHost=auto 时被消费）。 */
+  tmuxAvailable: boolean;
+}
+
+/** pty 宿主解析（显式优先；auto 看 tmux 探测）。 */
+function selectPtyHost(ptyHost: BridgeConfig["ptyHost"], tmuxAvailable: boolean, prefix: string): TransportSelection {
+  if (ptyHost === "tmux") return { mode: "pty-tmux", reason: `${prefix}；ptyHost=tmux（显式）` };
+  if (ptyHost === "script") return { mode: "pty-script", reason: `${prefix}；ptyHost=script（显式）` };
+  return tmuxAvailable
+    ? { mode: "pty-tmux", reason: `${prefix}；ptyHost=auto：tmux 可用 → tmux` }
+    : { mode: "pty-script", reason: `${prefix}；ptyHost=auto：tmux 不可用 → script` };
+}
+
+/**
+ * R-cr1 传输选择（纯函数，禁 I/O）：
+ * - 显式 transport=structured / pty 直接采用（显式值优先）；
+ * - auto：有凭据 → structured；否则 pty（宿主按 ptyHost 解析）。
+ */
+export function selectTransport(input: SelectTransportInput): TransportSelection {
+  if (input.transport === "structured") {
+    return { mode: "structured", reason: "配置 transport=structured（显式）" };
+  }
+  if (input.transport === "pty") {
+    return selectPtyHost(input.ptyHost, input.tmuxAvailable, "配置 transport=pty（显式）");
+  }
+  if (input.hasAksk) {
+    return { mode: "structured", reason: "auto：检测到 AK/SK 凭据 → structured" };
+  }
+  return selectPtyHost(input.ptyHost, input.tmuxAvailable, "auto：未检测到 AK/SK 凭据 → pty");
+}
+
+/**
+ * 是否需要 tmux 可用性探测（避免无谓 spawn：仅 ptyHost=auto 且决策可能落到 pty 时）。
+ * T3-07 起导出：daemon 生产装配（cli.ts resolveProductionTransport）与 runOnce
+ * 共用同一探测条件，杜绝第二套选择真相源（M78 双份同码教训）。
+ */
+export function needsTmuxProbe(transport: BridgeConfig["transport"], ptyHost: BridgeConfig["ptyHost"], hasAksk: boolean): boolean {
+  if (ptyHost !== "auto") return false;
+  if (transport === "pty") return true;
+  return transport === "auto" && !hasAksk;
+}
+
+/* ───── 生产装配（传输工厂 / tmux 探测 / 时钟） ───── */
+
+/** 生产传输工厂：按选择结果构造对应真实传输（注入 seam 供测试替换）。 */
+export function defaultBuildTransport(sel: TransportSelection): CodeartsTransport {
+  switch (sel.mode) {
+    case "structured":
+      return createStructuredTransport({ spawnProc: nodeRunSpawnProc });
+    case "pty-tmux":
+      return createTmuxTransport(nodeTmuxExec());
+    case "pty-script":
+      return createScriptTransport({ spawnPty: nodeScriptSpawnPty });
+  }
+}
+
+/**
+ * 生产 tmux 可用性探测：`tmux -V` 退出码 0 → 可用；PTY_HOST_UNAVAILABLE
+ * （PATH 无 tmux / 探测失败）→ 不可用（显式事实，选择 reason 留痕）；其余
+ * 错误原样上抛（禁静默吞错）。
+ */
+export async function probeTmuxAvailable(): Promise<boolean> {
+  try {
+    await nodeTmuxExec().run(["-V"]);
+    return true;
+  } catch (e) {
+    if (e instanceof BridgeError && e.code === "PTY_HOST_UNAVAILABLE") return false;
+    throw e;
+  }
+}
+
+/** 可注入时钟（now + 可取消 delay；测试用 FakeClock 确定性驱动）。 */
+export interface RunClock {
+  now(): number;
+  /** 可取消延时：cancel 后 promise 永不再触发回调（防事件循环悬挂/迟到触发）。 */
+  delay(ms: number): { promise: Promise<void>; cancel(): void };
+}
+
+/** 生产时钟：Date.now + setTimeout/clearTimeout。 */
+export const defaultRunClock: RunClock = {
+  now: () => Date.now(),
+  delay(ms: number) {
+    let handle: ReturnType<typeof setTimeout> | undefined;
+    const promise = new Promise<void>((resolve) => {
+      handle = setTimeout(resolve, ms);
+    });
+    return {
+      promise,
+      cancel: () => {
+        if (handle !== undefined) clearTimeout(handle);
+        handle = undefined;
+      },
+    };
+  },
+};
+
+/* ───── runOnce：单轮运行编排 ───── */
+
+/** runOnce 输入（cfg 必带；其余缺省见各字段注）。 */
+export interface RunOnceInput {
+  /** 全局配置（transport/ptyHost/akskFile/stateDir 由 selectTransport 与审计消费）。 */
+  cfg: BridgeConfig;
+  /** 注入会话的 prompt（非空；空串显式报错）。 */
+  prompt: string;
+  /** 续接的会话引用（缺省新建会话）。 */
+  session?: SessionRef;
+  /** 超时毫秒（正整数；缺省 RUN_DEFAULT_TIMEOUT_MS）。 */
+  timeoutMs?: number;
+  /** 宿主进度通道（R-cr3；缺省=无进度通道，如实跳过——非宿主调用场景）。 */
+  progress?: (update: { status: string }) => unknown;
+  /** 宿主取消信号（R-cr3；缺省=不可取消，超时仍兜底运行上限——显式文档）。 */
+  signal?: AbortSignal;
+  /** tmux 探测（缺省 probeTmuxAvailable；测试注入确定性结果）。 */
+  tmuxProbe?: () => Promise<boolean>;
+  /** 传输工厂（缺省 defaultBuildTransport；测试注入 FakeTransport）。 */
+  buildTransport?: (sel: TransportSelection) => CodeartsTransport;
+  /** 时钟（缺省 defaultRunClock；测试注入 FakeClock）。 */
+  clock?: RunClock;
+  /** 内核数据目录（R-p2 传参口径；仅真实 PTY 传输的日志源消费）。 */
+  kernelDataDir?: string;
+}
+
+/** runOnce 结构化结果（契约字段：session/summary/signals/mode/reason/auditId）。 */
+export interface RunResult {
+  status: "completed" | "timeout" | "cancelled" | "ended";
+  /** 会话引用（structured/pty 会话可供续接——timeout/cancelled 路径已 stop 除外）。 */
+  session: SessionRef;
+  mode: RunTransportMode;
+  /** 传输选择原因（R-cr1 无静默切换）。 */
+  reason: string;
+  /** 观察到的信号总数（含 done）。 */
+  signals: number;
+  /** error 信号数。 */
+  errors: number;
+  /** 任一 error 信号被 classifyError 判为 retryable（不静默重试的显式标记）。 */
+  retryable: boolean;
+  /** 已捕获输出摘要（output+error 文本尾部，≤RUN_SUMMARY_MAX_CHARS）。 */
+  summary: string;
+  /** 捕获文本总字节数（UTF-8）。 */
+  outputBytes: number;
+  durationMs: number;
+  /** 审计 id（run.start/run.exit 成对共用）。 */
+  auditId: string;
+  /** 进度通道失败次数（>0 才出现——进度通道故障的显式留痕，非静默）。 */
+  progressFailures?: number;
+}
+
+/** 输入校验（显式报错，禁静默截断/钳位）。 */
+function validateInput(prompt: string, timeoutMs: number): void {
+  if (typeof prompt !== "string" || prompt.length === 0) {
+    throw new BridgeError("TOOL_INPUT_INVALID", `prompt 须为非空字符串，实际为 ${typeof prompt}`);
+  }
+  if (!Number.isInteger(timeoutMs) || timeoutMs <= 0) {
+    throw new BridgeError("TOOL_INPUT_INVALID", `timeoutMs 须为正整数，实际为 ${String(timeoutMs)}`);
+  }
+}
+
+/**
+ * 单轮运行：选择传输 → start → 审计 run.start → 注入 prompt → 观察（进度节流 /
+ * 超时 / 取消）→ 审计 run.exit → 结构化结果。传输抛错的 BridgeError 原样上抛
+ * （工具层经 R-t1 以结构化 content 返回；run.exit 以 status="error" 留痕）。
+ */
+export async function runOnce(input: RunOnceInput): Promise<RunResult> {
+  const { cfg } = input;
+  const timeoutMs = input.timeoutMs ?? RUN_DEFAULT_TIMEOUT_MS;
+  validateInput(input.prompt, timeoutMs);
+
+  const clock = input.clock ?? defaultRunClock;
+  const buildTransport = input.buildTransport ?? defaultBuildTransport;
+  const tmuxProbe = input.tmuxProbe ?? probeTmuxAvailable;
+
+  // R-cr1：先解析选择输入（aksk 读取 + 按需 tmux 探测），再纯函数选择（无静默切换）
+  const aksk = await readAksk(cfg.akskFile);
+  const hasAksk = aksk !== undefined && aksk.AK !== undefined && aksk.AK !== "" && aksk.SK !== undefined && aksk.SK !== "";
+  let tmuxAvailable = false;
+  if (needsTmuxProbe(cfg.transport, cfg.ptyHost, hasAksk)) {
+    tmuxAvailable = await tmuxProbe();
+  }
+  const sel = selectTransport({ transport: cfg.transport, ptyHost: cfg.ptyHost, hasAksk, tmuxAvailable });
+
+  const transport = buildTransport(sel);
+  const ref = await transport.start(cfg, input.session);
+
+  const startedAt = clock.now();
+  const auditId = randomUUID();
+  const promptPreview = input.prompt.slice(0, RUN_PROMPT_PREVIEW_CHARS);
+
+  // R-cr4：run.start 先于注入落盘——审计失败则停止会话并显式报错（禁止无审计的运行）
+  try {
+    await appendInstallAudit(cfg, {
+      ts: new Date().toISOString(),
+      kind: "run.start",
+      auditId,
+      mode: sel.mode,
+      reason: sel.reason,
+      session: ref.id,
+      sessionKind: ref.kind,
+      promptLength: input.prompt.length,
+      promptPreview,
+      timeoutMs,
+      reused: input.session !== undefined,
+    });
+  } catch (e) {
+    // 清理失败不掩盖审计主错误（会话尚未注入 prompt，停止即干净回滚）
+    try {
+      await transport.stop(ref);
+    } catch {
+      // 停止失败仅说明会话残留（无 prompt 注入、无信号流），由 snapshot/下次运行对账
+    }
+    throw e;
+  }
+
+  const external = input.signal;
+  const ctrl = new AbortController();
+  const onExternalAbort = (): void => ctrl.abort();
+  external?.addEventListener("abort", onExternalAbort, { once: true });
+  // 已预先 abort 的宿主信号：监听器不会触发，须同步传播（取消语义对"开始前已取消"同样成立）
+  if (external?.aborted) ctrl.abort();
+
+  // R-cr2：超时定时——到点 abort（观察循环立即终止）→ finally stop → 结构化超时结果
+  let timerCancelled = false;
+  let timeoutFired = false;
+  const timer = clock.delay(timeoutMs);
+  void timer.promise.then(
+    () => {
+      if (timerCancelled) return;
+      timeoutFired = true;
+      ctrl.abort();
+    },
+    () => undefined, // delay 实现不允许 reject；防御性空转（不掩盖任何业务错误）
+  );
+
+  const textParts: string[] = [];
+  let outputBytes = 0;
+  let signalsCount = 0;
+  let errorsCount = 0;
+  let retryable = false;
+  let sawDone = false;
+  let progressFailures = 0;
+  let lastProgressAt = Number.NEGATIVE_INFINITY;
+  let runError: BridgeError | undefined;
+
+  // 捕获摘要（M50：error 路径 run.exit 审计与成功路径 schema 对齐——提前计算）
+  const fullText = () => textParts.join("");
+  const summarize = (): string => {
+    const t = fullText();
+    return t.length > RUN_SUMMARY_MAX_CHARS ? `…${t.slice(-RUN_SUMMARY_MAX_CHARS)}` : t;
+  };
+
+  // 进度通道失败不中断运行；计数入结果（显式留痕，非静默）
+  const reportProgress = async (status: string): Promise<void> => {
+    if (input.progress === undefined) return;
+    try {
+      await input.progress({ status });
+    } catch {
+      progressFailures++;
+    }
+  };
+
+  try {
+    // M48（修复环裁定）：预 abort 短路——start/审计完成后信号已取消的 prompt
+    // 不再写入目标会话（inject 零调用）；取消语义照常经 finally stop + 结构化
+    // cancelled 结果返回（非静默：status 如实标记取消事实）。
+    if (!ctrl.signal.aborted) {
+      await transport.inject(ref, input.prompt);
+      lastProgressAt = clock.now();
+      await reportProgress(`prompt 已提交（mode=${sel.mode}），等待目标响应`);
+      const observeOpts: ObserveOptions = {
+        signal: ctrl.signal,
+        ...(input.kernelDataDir !== undefined ? { kernelDataDir: input.kernelDataDir } : {}),
+      };
+      for await (const sig of transport.observe(ref, observeOpts)) {
+        signalsCount++;
+        if (sig.t === "error" && sig.text !== undefined) {
+          errorsCount++;
+          // 错误分级（R-s5 classifyError）：retryable → 显式标记；不静默重试
+          if (classifyError(sig.text) === "retryable") retryable = true;
+        }
+        if ((sig.t === "output" || sig.t === "error") && sig.text !== undefined) {
+          textParts.push(sig.text);
+          outputBytes += Buffer.byteLength(sig.text, "utf8");
+        }
+        if (sig.t === "done") {
+          sawDone = true;
+          break;
+        }
+        // R-cr3：信号批次 + 2s 节流
+        const now = clock.now();
+        if (now - lastProgressAt >= RUN_PROGRESS_THROTTLE_MS) {
+          lastProgressAt = now;
+          await reportProgress(`运行中：信号 ${signalsCount} 个（错误 ${errorsCount}）`);
+        }
+      }
+    }
+  } catch (e) {
+    runError = e instanceof BridgeError ? e : new BridgeError("INTERNAL", String(e), { cause: e });
+  } finally {
+    timerCancelled = true;
+    timer.cancel();
+    external?.removeEventListener("abort", onExternalAbort);
+    // R-cr2/R-cr3/错误路径：超时、取消、异常必 stop（显式清理）；
+    // completed/ended 不 stop（structured 会话保活供续接；PTY done 即进程已退）
+    if (timeoutFired || (external?.aborted ?? false) || runError !== undefined) {
+      try {
+        await transport.stop(ref);
+      } catch {
+        // 停止失败不掩盖主结果（会话残留由 snapshot/下次运行对账；stop 均幂等）
+      }
+    }
+  }
+
+  if (runError !== undefined) {
+    // R-cr4：异常路径 run.exit 以 status="error" 留痕（尽力而为，不掩盖上抛错误）。
+    // M50（修复环裁定）：补 outputBytes/summary——与成功路径 schema 对齐，
+    // error 留痕同样承载已捕获输出的事实（审计消费方单一 schema）。
+    try {
+      await appendInstallAudit(cfg, {
+        ts: new Date().toISOString(),
+        kind: "run.exit",
+        auditId,
+        mode: sel.mode,
+        session: ref.id,
+        sessionKind: ref.kind,
+        status: "error",
+        errorCode: runError.code,
+        errorMessage: runError.message,
+        signals: signalsCount,
+        errors: errorsCount,
+        retryable,
+        durationMs: clock.now() - startedAt,
+        outputBytes,
+        summary: summarize(),
+      });
+    } catch {
+      // run.start 已留痕；写失败属部署故障（R-t1 同纪律，不掩盖上抛的业务错误）
+    }
+    throw runError;
+  }
+
+  const summary = summarize();
+  const status: RunResult["status"] = sawDone
+    ? "completed"
+    : timeoutFired
+      ? "timeout"
+      : (external?.aborted ?? false)
+        ? "cancelled"
+        : "ended";
+
+  const result: RunResult = {
+    status,
+    session: { ...ref },
+    mode: sel.mode,
+    reason: sel.reason,
+    signals: signalsCount,
+    errors: errorsCount,
+    retryable,
+    summary,
+    outputBytes,
+    durationMs: clock.now() - startedAt,
+    auditId,
+  };
+  if (progressFailures > 0) result.progressFailures = progressFailures;
+
+  // R-cr4：run.exit 成对留痕（尽力而为；失败不掩盖运行结果，run.start 已保证落盘）
+  try {
+    await appendInstallAudit(cfg, {
+      ts: new Date().toISOString(),
+      kind: "run.exit",
+      auditId,
+      mode: sel.mode,
+      session: ref.id,
+      sessionKind: ref.kind,
+      status,
+      signals: signalsCount,
+      errors: errorsCount,
+      retryable,
+      durationMs: result.durationMs,
+      outputBytes,
+      summary,
+    });
+  } catch {
+    // 同上：run.start 已留痕；部署级写故障由 codearts_health/审计监控暴露
+  }
+
+  return result;
+}
diff --git a/plugins/codearts-bridge/src/core/service.ts b/plugins/codearts-bridge/src/core/service.ts
new file mode 100644
index 0000000000..f8d77a16c6
--- /dev/null
+++ b/plugins/codearts-bridge/src/core/service.ts
@@ -0,0 +1,223 @@
+/**
+ * codearts-bridge systemd 服务与 watchdog 单元生成器（T3-07，纯函数层）。
+ *
+ * 职责边界（主控裁定 R-sv1/R-sv2，progress.md Task 20）：
+ * - 本文件只做两件事：① systemd 单元文件的字符串渲染（R-sv2 纯函数，内容走
+ *   快照/内容断言测试）；② watchdog 探测结果的纯评估（R-sv1 evaluateProbe）。
+ *   一切 FS 写入、systemctl 调用、fetch 探测都在 CLI 命令层（src/cli.ts）经注入
+ *   依赖执行——测试绝不真装单元、绝不真连守护、绝不真重启服务。
+ *
+ * 范式来源（用户既有 dsh-web 运维模式，bin/dsh-watchdog-probe.sh）：
+ * - 进程崩溃由 systemd Restart=always 处理；watchdog 只管"活着但卡死"
+ *   （事件循环阻塞时 HTTP 探测超时/无响应）；
+ * - 任何 HTTP 状态码（含 401/500）都证明事件循环活着——有应答即健康、计数清零；
+ * - 连续 2 次无响应 → systemctl --user restart，计数清零重新累计；
+ * - 启动后 120s 宽限期不探测（等引导完成，防启动慢被误杀）；
+ * - 计数文件落在状态目录，探测失败原因分类留痕（R-sv4：stderr/journal）。
+ *
+ * 裁定偏差登记（签名细化，语义不偏离）：
+ * - renderWatchdogUnits 接收与 renderServiceUnit 相同的 ServiceUnitInput：裁定文
+ *   写作 `renderWatchdogUnits()`，但 R-sv2 内容断言要求 watchdog 单元的 ExecStart
+ *   同样是"绝对路径"，无参签名无法嵌入 bun/cli 绝对路径——取同参签名保住绝对
+ *   路径断言，纯函数性质不变。
+ *
+ * 错误纪律（仓库铁律）：非法输入（相对路径/负数/非整数）就地显式抛 BridgeError，
+ * 禁止静默钳位或补默认值。
+ */
+import * as path from "node:path";
+import { BridgeError } from "./errors";
+
+/* ───── 常量（单一真相，CLI 命令层与单元渲染共用） ───── */
+
+/** 启动宽限期秒数（R-sv1：启动后 120s 内不探测，等引导完成）。 */
+export const WATCHDOG_GRACE_SECONDS = 120;
+
+/** 连续无响应重启阈值（R-sv1：连续 ≥2 次无响应 → restart）。 */
+export const WATCHDOG_FAIL_THRESHOLD = 2;
+
+/** 探测超时毫秒（R-sv1：fetch /health 15s 超时）。 */
+export const WATCHDOG_PROBE_TIMEOUT_MS = 15_000;
+
+/** 无响应计数文件名（位于状态根；R-sv1：stateDir/watchdog-fails）。 */
+export const WATCHDOG_FAILS_FILE = "watchdog-fails";
+
+/** 三个 systemd 单元文件名（R-sv3：~/.config/systemd/user/ 下的安装目标）。 */
+export const SERVICE_UNIT_NAMES = {
+  daemon: "codearts-bridge.service",
+  watchdogService: "codearts-bridge-watchdog.service",
+  watchdogTimer: "codearts-bridge-watchdog.timer",
+} as const;
+
+/** 守护崩溃重启间隔秒（Restart=always 的再拉起节拍；与 watchdog 分钟级探活互补）。 */
+export const SERVICE_RESTART_SEC = 3;
+
+/* ───── 单元生成器（R-sv2） ───── */
+
+/** 单元渲染输入（全部绝对路径；user 服务缺省省略 User= 指令）。 */
+export interface ServiceUnitInput {
+  /** bun 可执行绝对路径（安装时经 process.execPath 探测）。 */
+  bunPath: string;
+  /** cli.ts 绝对路径（ExecStart 第二段：bun <cli.ts> daemon|watchdog-probe）。 */
+  cliPath: string;
+  /** 状态根绝对路径（经 Environment 钉入，守护与 watchdog 同一真相源）。 */
+  stateDir: string;
+  /** 可选 User= 指令（系统级服务变体；user 服务不需要）。 */
+  user?: string;
+}
+
+/** 绝对路径校验（systemd ExecStart 硬性要求绝对路径；相对路径显式拒绝）。 */
+function requireAbsolute(field: string, value: string): string {
+  if (typeof value !== "string" || value.length === 0 || !path.isAbsolute(value)) {
+    throw new BridgeError(
+      "SERVICE_UNIT_INPUT_INVALID",
+      `${field} 必须为非空绝对路径（systemd ExecStart 要求），实际为 ${JSON.stringify(value)}`,
+    );
+  }
+  return value;
+}
+
+/**
+ * 渲染守护单元 codearts-bridge.service（R-sv2 纯函数）。
+ *
+ * - Restart=always + RestartSec：进程崩溃/退出的自愈归 systemd（watchdog 只管
+ *   挂起——dsh 原型分工注释原样保留）；
+ * - ExecStart 双路径加引号：路径含空格时 systemd 仍按单参数解析；
+ * - Environment 钉 CODEARTS_BRIDGE_STATE_DIR：守护进程与 watchdog-probe 命令
+ *   经同一环境变量取得状态根，杜绝两套路径真相源漂移；
+ * - 日志三件套（StandardOutput/StandardError=journal + SyslogIdentifier）：
+ *   stdout/stderr 全部落 journald，`journalctl --user -t codearts-bridge` 可查
+ *   （R-sv2"日志到 journal"断言对象）。
+ */
+export function renderServiceUnit(input: ServiceUnitInput): string {
+  const bunPath = requireAbsolute("bunPath", input.bunPath);
+  const cliPath = requireAbsolute("cliPath", input.cliPath);
+  const stateDir = requireAbsolute("stateDir", input.stateDir);
+  const userLine = input.user !== undefined ? `User=${input.user}\n` : "";
+  return [
+    "[Unit]",
+    "Description=codearts-bridge 守护进程（目标引擎常驻宿主）",
+    "After=network.target",
+    "",
+    "[Service]",
+    userLine,
+    `ExecStart="${bunPath}" "${cliPath}" daemon`,
+    "Restart=always",
+    `RestartSec=${SERVICE_RESTART_SEC}`,
+    `Environment="CODEARTS_BRIDGE_STATE_DIR=${stateDir}"`,
+    "StandardOutput=journal",
+    "StandardError=journal",
+    "SyslogIdentifier=codearts-bridge",
+    "",
+    "[Install]",
+    "WantedBy=default.target",
+    "",
+  ].join("\n");
+}
+
+/**
+ * 渲染 watchdog 单元对（R-sv2 纯函数）：oneshot 探测服务 + 每分钟触发 timer。
+ *
+ * - watchdog.service 由 timer 激活（不单独 enable），Type=oneshot 跑完即退；
+ * - timer OnCalendar=minutely 每分钟一次；Persistent=true 补跑休眠/停机期间
+ *   错过的触发（探针幂等，补跑无害）；
+ * - ExecStart 与守护单元同参渲染（绝对路径断言一致，见头注偏差登记）。
+ */
+export function renderWatchdogUnits(input: ServiceUnitInput): { service: string; timer: string } {
+  const bunPath = requireAbsolute("bunPath", input.bunPath);
+  const cliPath = requireAbsolute("cliPath", input.cliPath);
+  const service = [
+    "[Unit]",
+    `Description=codearts-bridge watchdog 探测（每分钟；连续 ${WATCHDOG_FAIL_THRESHOLD} 次无响应重启守护）`,
+    `After=${SERVICE_UNIT_NAMES.daemon}`,
+    "",
+    "[Service]",
+    "Type=oneshot",
+    `ExecStart="${bunPath}" "${cliPath}" watchdog-probe`,
+    "StandardOutput=journal",
+    "StandardError=journal",
+    "SyslogIdentifier=codearts-bridge-watchdog",
+    "",
+  ].join("\n");
+  const timer = [
+    "[Unit]",
+    "Description=codearts-bridge watchdog 探测定时器（每分钟）",
+    "",
+    "[Timer]",
+    "OnCalendar=minutely",
+    "Persistent=true",
+    `Unit=${SERVICE_UNIT_NAMES.watchdogService}`,
+    "",
+    "[Install]",
+    "WantedBy=timers.target",
+    "",
+  ].join("\n");
+  return { service, timer };
+}
+
+/* ───── 探测评估纯函数（R-sv1） ───── */
+
+/** 探测裁决动作（R-sv1 固定三值）。 */
+export type ProbeAction = "ok" | "increment" | "restart";
+
+/** evaluateProbe 输入（纯数据；命令层负责把真实探测归一到这三字段）。 */
+export interface EvaluateProbeInput {
+  /**
+   * 本轮探测的 HTTP 状态码：0 = 无响应（连接拒绝/超时等一切未拿到 HTTP 应答的
+   * 失败）；非 0 = 收到 HTTP 应答——任意状态码（含 401/500）都证明事件循环活着
+   * （dsh 原型口径；体级异常的分类留痕归命令层 stderr，不参与重启判定）。
+   */
+  httpCode: number;
+  /** 上一轮累计的连续无响应次数（计数文件读数；≥0）。 */
+  prevFails: number;
+  /** 宽限期内（不探测）：ok 且计数原样保留，不计数不清零（dsh 原型同语义）。 */
+  graceActive: boolean;
+}
+
+/** 探测裁决（R-sv1 输出形态 + atMs 时间戳供结构化日志）。 */
+export interface ProbeVerdict {
+  action: ProbeAction;
+  /**
+   * 本轮应落盘的计数：0 = 应清除计数文件；>0 = 应写入该值。
+   * 宽限期跳过时原样回传 prevFails（命令层对应"不动计数文件"）。
+   */
+  fails: number;
+  /** 评估时刻（入参 now 透传；stderr/journal 结构化行取时用）。 */
+  atMs: number;
+}
+
+function requireNonNegativeInt(field: string, value: number): number {
+  if (!Number.isInteger(value) || value < 0) {
+    throw new BridgeError(
+      "WATCHDOG_INPUT_INVALID",
+      `${field} 必须为非负整数，实际为 ${JSON.stringify(value)}`,
+    );
+  }
+  return value;
+}
+
+/**
+ * watchdog 探测裁决（R-sv1 纯函数）：
+ * - graceActive → ok（计数原样）：宽限期不探测、不动计数（含既有计数不清零，
+ *   对齐 dsh 原型"宽限期内直接退出"）；
+ * - httpCode > 0 → ok 且计数清零：有应答 = 事件循环存活；
+ * - httpCode = 0 → fails = prevFails + 1：达到阈值 → restart（计数清零，重启后
+ *   重新累计）；未达阈值 → increment（落盘新计数，等下一轮）。
+ */
+export function evaluateProbe(input: EvaluateProbeInput, now: number): ProbeVerdict {
+  const httpCode = requireNonNegativeInt("httpCode", input.httpCode);
+  const prevFails = requireNonNegativeInt("prevFails", input.prevFails);
+  if (!Number.isFinite(now)) {
+    throw new BridgeError("WATCHDOG_INPUT_INVALID", `now 必须为有限数字，实际为 ${JSON.stringify(now)}`);
+  }
+  if (input.graceActive) {
+    return { action: "ok", fails: prevFails, atMs: now };
+  }
+  if (httpCode > 0) {
+    return { action: "ok", fails: 0, atMs: now };
+  }
+  const fails = prevFails + 1;
+  if (fails >= WATCHDOG_FAIL_THRESHOLD) {
+    return { action: "restart", fails: 0, atMs: now };
+  }
+  return { action: "increment", fails, atMs: now };
+}
diff --git a/plugins/codearts-bridge/src/core/transport/fake.ts b/plugins/codearts-bridge/src/core/transport/fake.ts
new file mode 100644
index 0000000000..31b7becb7b
--- /dev/null
+++ b/plugins/codearts-bridge/src/core/transport/fake.ts
@@ -0,0 +1,306 @@
+/**
+ * codearts-bridge FakeTransport（T2-01）。
+ *
+ * 职责：CodeartsTransport 的确定性测试替身——不 spawn 任何进程、无 FS/网络
+ * 副作用（R-tr4）。M3 监督状态机（T3-03）将直接注入本类做行为测试；后续真实
+ * 传输（T2-02/T2-03/T2-04）以 types.ts 为契约对齐本类的可观测语义。
+ *
+ * 可复用性设计（主控裁定 2026-10-31 R-tr3，逐条落实）：
+ * - ① 脚本化信号队列：`push(ref, sig)` 原样入队 / `emit(ref, t, text?)` 便捷
+ *   入队——均显式按 ref 寻址（与六方法一致，多会话脚本无歧义）；队列被消费
+ *   期间可继续追加，observe 挂起等待新信号（事件驱动唤醒，无任何定时器——⑤）。
+ * - ② 注入留痕：`injections` 按调用顺序记录每次 inject 的 {ref, text, at}，
+ *   供"两步提交/注入留痕"断言；stop 后留痕不丢。
+ * - ③ alive 可切换：stop → false；start 复用同一 ref（恢复语义）→ true。
+ * - ④ stop 后 observe 正常终止（挂起中的 next 得 done）、后续 observe 立即
+ *   正常结束（空迭代）、alive=false；stop 幂等。
+ * - ⑤ `at` 时间线：**调用序计数器**（二选一裁定：弃注入时钟），会话级单调
+ *   递增、inject 与 emit 共享同一刻度（与真实传输的事件序一致）；
+ *   start 复用归零（新生命期的确定性起点）。
+ *
+ * 语义裁决（显式报错，禁静默兜底）：
+ * - 未知 ref：inject/observe/stop/snapshot 同步抛 `SESSION_UNKNOWN`，不产生任何
+ *   副作用；alive 为**布尔查询**返回 false、start 采纳未知 ref 为新会话
+ *   （修复环第 1 轮裁定③④，2026-10-31：与真实传输同源对齐——守护重启对账
+ *   必经未知 ref，alive=false 走重建、start(未知 ref)=采纳重建）；
+ * - 对非存活会话 inject：抛 `SESSION_NOT_ALIVE` 且不留痕；
+ * - 同一 ref 并发第二个 observe：同步抛 `OBSERVER_ACTIVE`（单观察者模型，
+ *   消除多消费者争抢信号的歧义；迭代器结束/return/abort 释放后可重新 observe）；
+ * - observe 的 signal abort：迭代**立即正常结束**（"立即放弃"语义——已入队
+ *   未消费的残存信号丢弃，不抛错，R-tr2）；
+ * - snapshot.raw：会话 raw 缓冲按序拼接的 output/error 信号 text（入队时
+ *   累积、与是否被 observe 消费无关，模拟终端缓冲区）；其余信号类型与无
+ *   text 信号不进 raw。meta 含 id/kind/alive/closed/injections/signalCount
+ *   （signalCount = 累计入队信号总数，含已消费）。
+ */
+
+import type { BridgeConfig } from "../config";
+import { BridgeError } from "../errors";
+import type { CodeartsTransport, ObserveOptions, SessionRef, Signal, TransportKind } from "./types";
+
+/** 注入留痕条目（injections 数组元素；ref 用于多会话场景区分归属）。 */
+export interface InjectionRecord {
+  ref: SessionRef;
+  text: string;
+  at: number;
+}
+
+/** FakeTransport 构造选项。 */
+export interface FakeTransportOptions {
+  /** 传输种类（SessionRef.kind 与之一致）；缺省 "pty"。 */
+  kind?: TransportKind;
+}
+
+/** 单个 fake 会话的全部可变状态（经 ref.id 寻址）。 */
+interface FakeSession {
+  ref: SessionRef;
+  alive: boolean;
+  /** stop 置位：observe 迭代终止条件之一（与 alive 双保险，语义一致）。 */
+  closed: boolean;
+  /** 脚本化信号队列（push/emit 入队，observe 按序消费）。 */
+  pending: Signal[];
+  /** 累计入队信号总数（含已消费；snapshot.meta.signalCount）。 */
+  signalCount: number;
+  /** raw 缓冲：入队的 output/error 信号 text 按序累积（与消费无关）。 */
+  raw: string;
+  /** 调用序时间线计数器（inject/emit 共享；start 复用归零）。 */
+  atNext: number;
+  /** 等待新信号的唤醒函数集合（observe 迭代器注册；push/stop/abort 时逐个唤醒）。 */
+  waiters: Array<() => void>;
+  /** 当前活跃观察者标记（单观察者模型；null = 无）。 */
+  observer: symbol | null;
+}
+
+/** FakeTransport：脚本化信号 / 注入留痕 / 可切换存活的确定性传输替身。 */
+export class FakeTransport implements CodeartsTransport {
+  readonly kind: TransportKind;
+
+  /** 注入留痕（只读纪律：调用方只读，勿改写——数组引用直接暴露以保持零拷贝）。 */
+  readonly injections: InjectionRecord[] = [];
+
+  /** 会话表：id → 状态。含已 stop 的会话（留痕/快照不丢）。 */
+  private readonly sessions = new Map<string, FakeSession>();
+
+  /** start 自增序号（新会话 id 生成：`fake-<n>`）。 */
+  private idNext = 0;
+
+  constructor(opts: FakeTransportOptions = {}) {
+    this.kind = opts.kind ?? "pty";
+  }
+
+  /* ───── CodeartsTransport 六方法 ───── */
+
+  async start(cfg: BridgeConfig, ref?: SessionRef): Promise<SessionRef> {
+    // cfg 仅满足接口签名；Fake 不读配置、无副作用（R-tr4）。显式标注以示故意。
+    void cfg;
+    if (ref !== undefined) {
+      if (ref.kind !== this.kind) {
+        // kind 不符 = 非本传输的引用（与 script/tmux 非法引用同裁决：SESSION_UNKNOWN）
+        throw new BridgeError("SESSION_UNKNOWN", `非法会话引用：kind=${ref.kind} id=${ref.id}`, {
+          remediation: "仅可使用本 transport.start 返回过的 SessionRef。",
+        });
+      }
+      let s = this.sessions.get(ref.id);
+      if (s === undefined) {
+        // 修复环裁定③（2026-10-31）：未知但形态合法的 ref = 跨守护重启对账
+        // 语义（与真实传输对齐）：采纳为新会话（id 保留调用方值）。
+        s = {
+          ref: { ...ref },
+          alive: true,
+          closed: false,
+          pending: [],
+          signalCount: 0,
+          raw: "",
+          atNext: 0,
+          waiters: [],
+          observer: null,
+        };
+        this.sessions.set(ref.id, s);
+      }
+      // 复用/恢复语义：复活会话并归零时间线；信号队列、raw 缓冲、注入留痕
+      // 一律保留（留痕是审计事实，重启不抹除）。
+      s.alive = true;
+      s.closed = false;
+      s.atNext = 0;
+      return { ...s.ref };
+    }
+    const id = `fake-${++this.idNext}`;
+    const created: SessionRef = { kind: this.kind, id };
+    this.sessions.set(id, {
+      ref: created,
+      alive: true,
+      closed: false,
+      pending: [],
+      signalCount: 0,
+      raw: "",
+      atNext: 0,
+      waiters: [],
+      observer: null,
+    });
+    return { ...created };
+  }
+
+  async inject(ref: SessionRef, text: string): Promise<void> {
+    const s = this.requireSession(ref);
+    if (!s.alive) {
+      throw new BridgeError("SESSION_NOT_ALIVE", `会话已停止，拒绝注入：id=${ref.id}`, {
+        remediation: "先 start 复用该会话引用恢复存活，再注入。",
+      });
+    }
+    this.injections.push({ ref: { ...s.ref }, text, at: s.atNext++ });
+  }
+
+  observe(ref: SessionRef, opts?: ObserveOptions): AsyncIterable<Signal> {
+    const s = this.requireSession(ref);
+    if (s.observer !== null) {
+      throw new BridgeError(
+        "OBSERVER_ACTIVE",
+        `会话已有活跃观察者（单观察者模型）：id=${ref.id}`,
+        { remediation: "先结束当前观察（迭代完成/return/abort）再重新 observe。" },
+      );
+    }
+    // 已 abort：立即正常结束的空迭代，且不占用观察者名额（"未开始即取消"）。
+    if (opts?.signal?.aborted) return emptySignals();
+
+    const token = Symbol("observer");
+    s.observer = token;
+    const self = this;
+    // 消费方显式终结标记：包装迭代器 return/throw 置位并唤醒挂起等待（M34），
+    // 挂起中的 next 立即正常落定，委托给 async generator 的 return/throw 请求
+    // 才有机会被处理（否则排在永不落定的 next 之后，同样永不落定）。
+    let terminated = false;
+
+    async function* iterate(): AsyncGenerator<Signal> {
+      const signal = opts?.signal;
+      const onAbort = (): void => self.wakeAll(s);
+      signal?.addEventListener("abort", onAbort, { once: true });
+      try {
+        while (true) {
+          // abort = 立即放弃：每次 next 先检查，未消费残存信号丢弃（R-tr2 正常结束）；
+          // 消费方 return/throw 同为立即放弃（terminated，M34 对称语义）。
+          if (signal?.aborted || terminated) return;
+          if (s.pending.length === 0) {
+            if (s.closed || !s.alive) return;
+            await waitFor(s);
+            continue;
+          }
+          yield s.pending.shift() as Signal;
+        }
+      } finally {
+        signal?.removeEventListener("abort", onAbort);
+        self.releaseObserver(s, token);
+      }
+    }
+
+    // 包装迭代器：显式 return/throw 时先同步终结挂起等待并释放观察者再委托——
+    // ① "未启动即 return"（async generator 体未执行、finally 不触发）也不泄漏；
+    // ② 挂起等待（pending next 于 waitFor）时对称唤醒（M34）：与 abort 路径同态，
+    //    挂起中的 next 立即正常落定（done）、残存信号丢弃，消费方调用不悬死。
+    const inner = iterate();
+    const iterator: AsyncIterator<Signal> = {
+      next: () => inner.next(),
+      return: (v?: unknown) => {
+        terminated = true;
+        self.releaseObserver(s, token);
+        self.wakeAll(s);
+        return inner.return(v as undefined);
+      },
+      throw: (e?: unknown) => {
+        terminated = true;
+        self.releaseObserver(s, token);
+        self.wakeAll(s);
+        return inner.throw(e);
+      },
+    };
+    return { [Symbol.asyncIterator]: () => iterator };
+  }
+
+  async alive(ref: SessionRef): Promise<boolean> {
+    // 修复环裁定④（2026-10-31）：布尔查询——未知 ref → false（不抛错，
+    // 与真实传输同源对齐；守护重启对账凭 false 走重建路径）。
+    return this.sessions.get(ref.id)?.alive ?? false;
+  }
+
+  async stop(ref: SessionRef): Promise<void> {
+    const s = this.requireSession(ref);
+    s.alive = false;
+    s.closed = true;
+    this.wakeAll(s);
+  }
+
+  async snapshot(ref: SessionRef): Promise<{ raw: string; meta: Record<string, unknown> }> {
+    const s = this.requireSession(ref);
+    return {
+      raw: s.raw,
+      meta: {
+        id: s.ref.id,
+        kind: s.ref.kind,
+        alive: s.alive,
+        closed: s.closed,
+        injections: this.injections.filter((i) => i.ref.id === s.ref.id).length,
+        signalCount: s.signalCount,
+      },
+    };
+  }
+
+  /* ───── Fake 特有脚本 API（测试/T3-03 使用，不属于 CodeartsTransport） ───── */
+
+  /**
+   * 向指定会话原样入队一个信号（脚本方完全控制，含 at）；
+   * 同时累积 raw 缓冲（output/error 带 text 时）并唤醒挂起的观察者。
+   */
+  push(ref: SessionRef, sig: Signal): void {
+    const s = this.requireSession(ref);
+    if ((sig.t === "output" || sig.t === "error") && sig.text !== undefined) {
+      s.raw += sig.text;
+    }
+    s.pending.push(sig);
+    s.signalCount++;
+    this.wakeAll(s);
+  }
+
+  /** 便捷入队：at 由会话调用序计数器提供（与 inject 共享时间线）；返回入队的信号。 */
+  emit(ref: SessionRef, t: Signal["t"], text?: string): Signal {
+    const s = this.requireSession(ref);
+    const at = s.atNext++;
+    const sig: Signal = text !== undefined ? { t, at, text } : { t, at };
+    this.push(ref, sig);
+    return sig;
+  }
+
+  /* ───── 内部机制 ───── */
+
+  /** 未知 ref 显式报错（全部方法的统一入口守卫，禁静默兜底）。 */
+  private requireSession(ref: SessionRef): FakeSession {
+    const s = this.sessions.get(ref.id);
+    if (s === undefined) {
+      throw new BridgeError("SESSION_UNKNOWN", `未知会话引用：kind=${ref.kind} id=${ref.id}`, {
+        remediation: "仅可使用本 transport.start 返回过的 SessionRef。",
+      });
+    }
+    return s;
+  }
+
+  /** 释放观察者（仅持有者可释放；幂等）。 */
+  private releaseObserver(s: FakeSession, token: symbol): void {
+    if (s.observer === token) s.observer = null;
+  }
+
+  /** 唤醒全部挂起等待者（push/stop/abort 路径共用；等待者醒来后自旋复查状态）。 */
+  private wakeAll(s: FakeSession): void {
+    const waiters = s.waiters.splice(0);
+    for (const wake of waiters) wake();
+  }
+}
+
+/** 注册挂起等待：队列/终止状态变化时被唤醒（事件驱动，无定时器）。 */
+function waitFor(s: FakeSession): Promise<void> {
+  return new Promise((resolve) => {
+    s.waiters.push(resolve);
+  });
+}
+
+/** 空信号迭代（observe 收到已 abort 的 signal 时返回；不占用观察者）。 */
+function emptySignals(): AsyncIterable<Signal> {
+  return (async function* () {})();
+}
