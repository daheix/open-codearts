+    expect(h.verifyCalls.length).toBe(1);
+    expect(h.verifyCalls[0]).toEqual(["make", "check"]);
+
+    // 审计：complete 恰一次（前两轮回显均未误判）
+    const events = await readLogsUntil(
+      h,
+      goalId,
+      (es) => es.filter((e) => e["type"] === "goal.complete").length === 1,
+      "goal.complete 恰一次",
