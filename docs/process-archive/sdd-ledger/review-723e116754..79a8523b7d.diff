+    // 第一次自报完成 → verify 失败 → 注入失败原因继续（不终止、不 blocked）
+    h.advance(ECHO_GUARD_MS + 1_000);
+    h.transport.emit(ref, "output", "全部完成 [GOAL-DONE]");
+    await h.loop.sweepOnce();
