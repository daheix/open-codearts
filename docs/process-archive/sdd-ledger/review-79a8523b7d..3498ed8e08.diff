+export const DOCTOR_DAEMON_TIMEOUT_MS = 3_000;
+
+/** 网络可达性 HEAD 超时（任务书固定 5s）。 */
+export const DOCTOR_NETWORK_TIMEOUT_MS = 5_000;
+
+/* ───── 磁盘阈值（⑦；字节） ───── */
+
+export const DOCTOR_DISK_DUMPS_WARN_BYTES = 500 * 1024 * 1024; // 堆快照 500MB
