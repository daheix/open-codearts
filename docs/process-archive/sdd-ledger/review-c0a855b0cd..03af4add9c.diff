+    // 若实现漏掉 PRAGMA，打开时的自动恢复不会替它完成 checkpoint（测试真实性）
+    const dbA = new Database(dbPath);
+    dbA.run("PRAGMA journal_mode=WAL");
+    dbA.run("PRAGMA wal_autocheckpoint=0");
+    dbA.run("CREATE TABLE t(x TEXT)");
