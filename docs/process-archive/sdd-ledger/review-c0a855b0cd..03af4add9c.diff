+const PLUGIN_ROOT = path.resolve(import.meta.dir, "..");
+const TEST_ROOT = path.join(PLUGIN_ROOT, ".tmp", "hygiene-test");
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+beforeEach(async () => {
+  await rm(TEST_ROOT, { recursive: true, force: true });
